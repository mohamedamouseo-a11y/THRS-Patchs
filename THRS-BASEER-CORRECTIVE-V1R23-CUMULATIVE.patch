+++ b/backend/src/services/baseer/voice-state-machine.js
@@ -0,0 +1,36 @@
+'use strict';
+const { BaseerError } = require('./errors');
+const ROOM_OPEN_STATUSES = Object.freeze(['CREATED', 'ACTIVE', 'TRANSCRIBING', 'TRANSCRIBED']);
+const TERMINAL_STATUSES = Object.freeze(['ENDED', 'FAILED', 'CONSENT_REVOKED']);
+function transition(status, event) {
+  const current = String(status || 'CREATED').toUpperCase();
+  const type = String(event || '').toUpperCase();
+  if (current === 'CONSENT_REVOKED') throw new BaseerError('VOICE_CONSENT_REVOKED', 'Voice session consent has been withdrawn.', 409);
+  if (type === 'RECORDING_READY') {
+    if (['ACTIVE', 'TRANSCRIBING', 'TRANSCRIBED', 'ENDED'].includes(current)) return { status: current, stale: false };
+    throw new BaseerError('VOICE_EVENT_OUT_OF_ORDER', `RECORDING_READY is not valid after ${current}.`, 409);
+  }
+  if (type === 'FAILED') return { status: current === 'ENDED' ? 'ENDED' : 'FAILED', stale: current === 'ENDED' || current === 'FAILED' };
+  if (type === 'ROOM_ENDED') {
+    if (current === 'FAILED') return { status: 'FAILED', stale: true };
+    return { status: 'ENDED', stale: current === 'ENDED' };
+  }
+  if (type === 'ROOM_STARTED') {
+    if (current === 'CREATED') return { status: 'ACTIVE', stale: false };
+    if (current === 'ACTIVE') return { status: 'ACTIVE', stale: true };
+    throw new BaseerError('VOICE_EVENT_OUT_OF_ORDER', `ROOM_STARTED is not valid after ${current}.`, 409);
+  }
+  if (type === 'TRANSCRIPT_PARTIAL') {
+    if (['CREATED', 'ACTIVE', 'TRANSCRIBING'].includes(current)) return { status: 'TRANSCRIBING', stale: false };
+    if (['TRANSCRIBED', 'ENDED'].includes(current)) return { status: current, stale: true };
+    throw new BaseerError('VOICE_EVENT_OUT_OF_ORDER', `TRANSCRIPT_PARTIAL is not valid after ${current}.`, 409);
+  }
+  if (type === 'TRANSCRIPT_FINAL') {
+    if (['CREATED', 'ACTIVE', 'TRANSCRIBING'].includes(current)) return { status: 'TRANSCRIBED', stale: false };
+    if (current === 'TRANSCRIBED') return { status: 'TRANSCRIBED', stale: true };
+    if (current === 'ENDED') return { status: 'ENDED', stale: false };
+    throw new BaseerError('VOICE_EVENT_OUT_OF_ORDER', `TRANSCRIPT_FINAL is not valid after ${current}.`, 409);
+  }
+  throw new BaseerError('VOICE_EVENT_INVALID', 'Unsupported voice callback event.', 400);
+}
+module.exports = { ROOM_OPEN_STATUSES, TERMINAL_STATUSES, transition };
