+'use strict';
+const test=require('node:test');const assert=require('node:assert/strict');
+const {optionalBoolean}=require('../src/services/baseer/public-input');
+const {transition,ROOM_OPEN_STATUSES}=require('../src/services/baseer/voice-state-machine');
+const {jobFailureStatus}=require('../src/services/baseer/job-retry-policy');
+
+test('public consent accepts only JSON booleans',()=>{
+ assert.equal(optionalBoolean({},'interview'),undefined);assert.equal(optionalBoolean({interview:false},'interview'),false);assert.equal(optionalBoolean({interview:true},'interview'),true);
+ for(const value of ['false','true',0,1,null])assert.throws(()=>optionalBoolean({interview:value},'interview'),/must be a JSON boolean/);
+ assert.throws(()=>optionalBoolean({recording:'false'},'recording'),/must be a JSON boolean/);
+});
+test('room ended is terminal even when a transcript exists',()=>{
+ assert.equal(transition('TRANSCRIBED','ROOM_ENDED').status,'ENDED');assert.ok(!ROOM_OPEN_STATUSES.includes('ENDED'));
+ assert.throws(()=>transition('ENDED','ROOM_STARTED'),/not valid/);assert.deepEqual(transition('FAILED','ROOM_ENDED'),{status:'FAILED',stale:true});
+});
+test('late transcript final can attach content without reopening ended room',()=>{
+ assert.deepEqual(transition('ENDED','TRANSCRIPT_FINAL'),{status:'ENDED',stale:false});
+ assert.deepEqual(transition('ENDED','TRANSCRIPT_PARTIAL'),{status:'ENDED',stale:true});
+});
+test('approved action failures are always reconciliation-only',()=>{
+ assert.equal(jobFailureStatus({jobType:'EXECUTE_APPROVED_ACTION',attempts:1,maxAttempts:5,timeout:false,uncertain:false}),'UNKNOWN');
+ assert.equal(jobFailureStatus({jobType:'EXECUTE_APPROVED_ACTION',attempts:1,maxAttempts:5,timeout:false,uncertain:true}),'UNKNOWN');
+});
+test('voice termination remains the only automatically retryable side effect',()=>{
+ assert.equal(jobFailureStatus({jobType:'TERMINATE_VOICE_ROOM',attempts:1,maxAttempts:3,timeout:true}),'PENDING');
+ assert.equal(jobFailureStatus({jobType:'TERMINATE_VOICE_ROOM',attempts:3,maxAttempts:3,timeout:true}),'FAILED');
+});
