diff --git a/scripts/baseer-v1r23-source-manifest.py b/scripts/baseer-v1r23-source-manifest.py
new file mode 100755
index 0000000..ab9dd82
--- /dev/null
+++ b/scripts/baseer-v1r23-source-manifest.py
@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+import hashlib,json,os,stat,sys
+from pathlib import Path
+EXCLUDED_DIRS={'.git','node_modules','build','coverage','.cache','__pycache__','.pytest_cache'}
+EXCLUDED_FILES={'.env','.DS_Store'}
+def ignored(rel):
+ p=rel.parts
+ if any(x in EXCLUDED_DIRS for x in p): return True
+ if p and p[-1] in EXCLUDED_FILES: return True
+ if p[:2]==('backend','uploads'): return True
+ if p and (p[-1].endswith('.log') or p[-1].endswith('.pyc')): return True
+ return False
+def digest(path):
+ h=hashlib.sha256()
+ with open(path,'rb') as f:
+  for b in iter(lambda:f.read(1024*1024),b''): h.update(b)
+ return h.hexdigest()
+def snapshot(root):
+ root=Path(root).resolve(strict=True); rows=[]
+ for current,dirs,files in os.walk(root,topdown=True,followlinks=False):
+  current=Path(current); kept=[]
+  for name in sorted(dirs):
+   path=current/name; rel=path.relative_to(root)
+   if ignored(rel): continue
+   info=os.lstat(path)
+   if stat.S_ISLNK(info.st_mode): raise SystemExit(f'symlink is forbidden: {rel}')
+   if not stat.S_ISDIR(info.st_mode): raise SystemExit(f'unsupported entry: {rel}')
+   kept.append(name)
+  dirs[:]=kept
+  for name in sorted(files):
+   path=current/name; rel=path.relative_to(root)
+   if ignored(rel): continue
+   info=os.lstat(path)
+   if not stat.S_ISREG(info.st_mode) or info.st_nlink!=1: raise SystemExit(f'unsafe source file: {rel}')
+   rows.append({'path':rel.as_posix(),'mode':stat.S_IMODE(info.st_mode),'size':info.st_size,'sha256':digest(path)})
+ return sorted(rows,key=lambda x:x['path'])
+def main():
+ if len(sys.argv)!=4 or sys.argv[1] not in {'generate','verify'}: raise SystemExit('usage: tool generate|verify ROOT MANIFEST')
+ rows=snapshot(sys.argv[2]); target=Path(sys.argv[3])
+ if sys.argv[1]=='generate': target.write_text('\n'.join(json.dumps(x,sort_keys=True,separators=(',',':')) for x in rows)+'\n'); return
+ expected=[json.loads(x) for x in target.read_text().splitlines() if x]
+ if rows!=expected:
+  a={x['path']:x for x in rows}; e={x['path']:x for x in expected}
+  for p in sorted(e.keys()-a.keys()): print(f'missing: {p}',file=sys.stderr)
+  for p in sorted(a.keys()-e.keys()): print(f'unexpected: {p}',file=sys.stderr)
+  for p in sorted(a.keys()&e.keys()):
+   if a[p]!=e[p]: print(f'changed: {p}',file=sys.stderr)
+  raise SystemExit('V1R22 source baseline mismatch')
+if __name__=='__main__': main()
