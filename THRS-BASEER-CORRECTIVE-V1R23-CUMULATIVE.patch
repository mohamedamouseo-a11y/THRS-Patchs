+#!/usr/bin/env bash
+set -Eeuo pipefail
+TARGET="${1:-}"; PREVIOUS_RELEASE="${2:-}"; STATE_DIR="${3:-}"; HEALTH_URL="${BASEER_HEALTHCHECK_URL:-${4:-}}"; PM2_NAMES="${BASEER_PM2_NAMES:-thrs-backend baseer-worker}"
+[[ -d "$TARGET" && -d "$PREVIOUS_RELEASE" && -d "$STATE_DIR" && -n "$HEALTH_URL" ]]||{ echo "Usage: $0 TARGET PREVIOUS_RELEASE STATE_DIR HEALTH_URL" >&2;exit 2; }
+for c in sha256sum python3 flock rsync pm2 curl node realpath cp stat;do command -v "$c" >/dev/null 2>&1||{ echo "Missing command: $c" >&2;exit 2;};done
+TARGET="$(realpath "$TARGET")";PREVIOUS_RELEASE="$(realpath "$PREVIOUS_RELEASE")";STATE_DIR="$(realpath "$STATE_DIR")";PARENT="$(dirname "$TARGET")";NAME="$(basename "$TARGET")";LOCK="$PARENT/.${NAME}-v1r23.lock"
+PREVIOUS_MANIFEST="$STATE_DIR/previous-release.manifest.jsonl";CURRENT_MANIFEST="$STATE_DIR/current-release.manifest.jsonl";MANIFEST_TOOL="$STATE_DIR/baseer-v1r21-runtime-manifest.py";STATE_CHECKSUMS="$STATE_DIR/STATE-CHECKSUMS.sha256"
+[[ "$(dirname "$PREVIOUS_RELEASE")" == "$PARENT" && "$PREVIOUS_RELEASE" != "$TARGET" ]]||exit 3
+atomic_exchange(){ python3 - "$1" "$2" <<'PY'
+import ctypes,os,platform,sys
+l=os.fsencode(os.path.abspath(sys.argv[1]));r=os.fsencode(os.path.abspath(sys.argv[2]));
+if os.stat(l).st_dev!=os.stat(r).st_dev:raise SystemExit('atomic exchange requires same filesystem')
+libc=ctypes.CDLL(None,use_errno=True);f=getattr(libc,'renameat2',None);n={'x86_64':316,'aarch64':276}.get(platform.machine());x=f(-100,l,-100,r,2) if f else libc.syscall(n,-100,l,-100,r,2)
+if x!=0:raise OSError(ctypes.get_errno(),os.strerror(ctypes.get_errno()))
+PY
+}
+verify_uploads(){ [[ ! -e "$1" && ! -L "$1" ]]&&return 0;python3 - "$1" <<'PY'
+import os,stat,sys
+root=sys.argv[1]
+info=os.lstat(root)
+if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):raise SystemExit(f'uploads root must be a real directory: {root}')
+root=os.path.realpath(root)
+for c,d,f in os.walk(root,followlinks=False):
+ for n in list(d)+list(f):
+  p=os.path.join(c,n);i=os.lstat(p)
+  if stat.S_ISLNK(i.st_mode) or not(stat.S_ISDIR(i.st_mode) or stat.S_ISREG(i.st_mode)):raise SystemExit(f'unsafe uploads entry: {p}')
+  if stat.S_ISREG(i.st_mode) and i.st_nlink!=1:raise SystemExit(f'hard-linked uploads file: {p}')
+PY
+}
+copy_env(){ local src="$1" dst="$2";[[ ! -e "$src" ]]&&return 0;[[ -f "$src" && ! -L "$src" && "$(stat -c %h "$src")" == 1 ]]||return 1;rm -f "$dst";cp -p --no-dereference "$src" "$dst"; }
+cleanup(){ local r="$1";[[ -f "$r/backend/scripts/baseer-runner-cleanup.js" ]]&&(cd "$r/backend"&&node scripts/baseer-runner-cleanup.js)||true; }
+verify_pm2(){ local s;s="$(mktemp)";pm2 jlist>"$s";node - "$s" "$PM2_NAMES" "$TARGET" <<'NODE'
+const fs=require('fs'),path=require('path'),rows=JSON.parse(fs.readFileSync(process.argv[2],'utf8')),names=process.argv[3].trim().split(/\s+/),target=fs.realpathSync.native(process.argv[4]);const inside=v=>{if(!v)return false;try{const r=fs.realpathSync.native(v);return r===target||r.startsWith(target+path.sep)}catch{return false}};for(const n of names){const x=rows.find(r=>r.name===n);if(!x)throw Error(`missing ${n}`);const e=x.pm2_env||{};if(e.status!=='online'||Number(x.pid)<=0||!inside(e.pm_cwd||e.cwd)||!inside(e.pm_exec_path))throw Error(`invalid PM2 ${n}`)}
+NODE
+rm -f "$s"; }
+restart_verify(){ local probe="${1:-false}";for p in $PM2_NAMES;do pm2 restart "$p" --update-env >/dev/null;done;sleep "${BASEER_STABILITY_SECONDS:-8}";verify_pm2;curl --fail --silent --show-error --retry 5 --retry-delay 2 --max-time 20 "$HEALTH_URL">/dev/null;if [[ "$probe" == true ]];then(cd "$TARGET/backend"&&npm run baseer:verify-worker-live-v1r23);fi; }
+exec 9>"$LOCK";flock -n 9||exit 3;(cd "$STATE_DIR"&&sha256sum -c "$(basename "$STATE_CHECKSUMS")">/dev/null);python3 "$MANIFEST_TOOL" verify-runtime "$TARGET" "$CURRENT_MANIFEST";python3 "$MANIFEST_TOOL" verify-runtime "$PREVIOUS_RELEASE" "$PREVIOUS_MANIFEST";verify_pm2
+# Carry forward the latest runtime configuration without trusting symlinks or hard links.
+copy_env "$TARGET/backend/.env" "$PREVIOUS_RELEASE/backend/.env";copy_env "$TARGET/frontend/.env" "$PREVIOUS_RELEASE/frontend/.env";verify_uploads "$TARGET/backend/uploads"
+for p in $PM2_NAMES;do pm2 stop "$p">/dev/null;done;cleanup "$TARGET";python3 "$MANIFEST_TOOL" verify-runtime "$TARGET" "$CURRENT_MANIFEST";python3 "$MANIFEST_TOOL" verify-runtime "$PREVIOUS_RELEASE" "$PREVIOUS_MANIFEST"
+if [[ -d "$TARGET/backend/uploads" ]];then mkdir -p "$PREVIOUS_RELEASE/backend/uploads";rsync -a --delete "$TARGET/backend/uploads/" "$PREVIOUS_RELEASE/backend/uploads/";fi;verify_uploads "$PREVIOUS_RELEASE/backend/uploads";atomic_exchange "$TARGET" "$PREVIOUS_RELEASE"
+if ! restart_verify false;then
+ for p in $PM2_NAMES;do pm2 stop "$p">/dev/null 2>&1||true;done;cleanup "$TARGET";python3 "$MANIFEST_TOOL" verify-runtime "$PREVIOUS_RELEASE" "$CURRENT_MANIFEST";atomic_exchange "$TARGET" "$PREVIOUS_RELEASE";restart_verify true||{ echo "CRITICAL: rollback and V1R23 recovery failed." >&2;exit 91;};echo "Rollback failed; verified V1R23 recovered." >&2;exit 90
+fi
+echo "BASEER_V1R23_FULL_SOURCE_ROLLBACK_OK"
