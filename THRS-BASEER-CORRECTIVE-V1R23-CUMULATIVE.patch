diff --git a/APPLY-THRS-BASEER-V1R23-FULL-SOURCE.sh b/APPLY-THRS-BASEER-V1R23-FULL-SOURCE.sh
new file mode 100755
index 0000000..41193d1
--- /dev/null
+++ b/APPLY-THRS-BASEER-V1R23-FULL-SOURCE.sh
@@ -0,0 +1,87 @@
+#!/usr/bin/env bash
+set -Eeuo pipefail
+ARCHIVE="${1:-}"; SHA_FILE="${2:-}"; TARGET="${3:-}"; HEALTH_URL="${BASEER_HEALTHCHECK_URL:-${4:-}}"; PM2_NAMES="${BASEER_PM2_NAMES:-thrs-backend baseer-worker}"
+[[ -f "$ARCHIVE" && -f "$SHA_FILE" && -d "$TARGET" && -n "$HEALTH_URL" ]] || { echo "Usage: $0 FULL_SOURCE.tar.gz FULL_SOURCE.sha256 TARGET HEALTH_URL" >&2; exit 2; }
+for c in sha256sum python3 tar npm flock rsync pm2 curl node realpath cp stat; do command -v "$c" >/dev/null 2>&1 || { echo "Missing command: $c" >&2; exit 2; }; done
+ARCHIVE="$(realpath "$ARCHIVE")"; SHA_FILE="$(realpath "$SHA_FILE")"; TARGET="$(realpath "$TARGET")"
+PARENT="$(dirname "$TARGET")"; NAME="$(basename "$TARGET")"; STAMP="$(date +%Y%m%d_%H%M%S)"
+WORK="$PARENT/.${NAME}-v1r23-build-$STAMP"; RELEASE="$PARENT/.${NAME}-v1r23-release-$STAMP"; STATE_DIR="$PARENT/.${NAME}-v1r23-state-$STAMP"; LOCK="$PARENT/.${NAME}-v1r23.lock"
+PREVIOUS_MANIFEST="$STATE_DIR/previous-release.manifest.jsonl"; CURRENT_MANIFEST="$STATE_DIR/current-release.manifest.jsonl"; MANIFEST_TOOL="$STATE_DIR/baseer-v1r21-runtime-manifest.py"; STATE_CHECKSUMS="$STATE_DIR/STATE-CHECKSUMS.sha256"
+SWAPPED=0; STOPPED=0; SUCCESS=0
+atomic_exchange(){ python3 - "$1" "$2" <<'PY'
+import ctypes,os,platform,sys
+l=os.fsencode(os.path.abspath(sys.argv[1]));r=os.fsencode(os.path.abspath(sys.argv[2]))
+if os.stat(l).st_dev!=os.stat(r).st_dev:raise SystemExit('atomic exchange requires same filesystem')
+libc=ctypes.CDLL(None,use_errno=True);f=getattr(libc,'renameat2',None);n={'x86_64':316,'aarch64':276}.get(platform.machine());result=f(-100,l,-100,r,2) if f else libc.syscall(n,-100,l,-100,r,2)
+if result!=0:raise OSError(ctypes.get_errno(),os.strerror(ctypes.get_errno()))
+PY
+}
+verify_pm2(){ local s; s="$(mktemp)"; pm2 jlist >"$s"; node - "$s" "$PM2_NAMES" "$TARGET" <<'NODE'
+const fs=require('fs'),path=require('path'),rows=JSON.parse(fs.readFileSync(process.argv[2],'utf8')),names=process.argv[3].trim().split(/\s+/),target=fs.realpathSync.native(process.argv[4]);const inside=v=>{if(!v)return false;try{const r=fs.realpathSync.native(v);return r===target||r.startsWith(target+path.sep)}catch{return false}};for(const n of names){const x=rows.find(r=>r.name===n);if(!x)throw Error(`missing PM2 process: ${n}`);const e=x.pm2_env||{};if(e.status!=='online'||Number(x.pid)<=0||!inside(e.pm_cwd||e.cwd)||!inside(e.pm_exec_path))throw Error(`invalid PM2 binding/status: ${n}`)}
+NODE
+rm -f "$s"; }
+verify_uploads_tree(){ [[ ! -e "$1" && ! -L "$1" ]] && return 0; python3 - "$1" <<'PY'
+import os,stat,sys
+root=sys.argv[1]
+info=os.lstat(root)
+if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):raise SystemExit(f'uploads root must be a real directory: {root}')
+root=os.path.realpath(root)
+for current,dirs,files in os.walk(root,followlinks=False):
+ for n in list(dirs)+list(files):
+  p=os.path.join(current,n);i=os.lstat(p)
+  if stat.S_ISLNK(i.st_mode) or not(stat.S_ISDIR(i.st_mode) or stat.S_ISREG(i.st_mode)):raise SystemExit(f'unsafe uploads entry: {p}')
+  if stat.S_ISREG(i.st_mode) and i.st_nlink!=1:raise SystemExit(f'hard-linked uploads file: {p}')
+PY
+}
+copy_env(){ local src="$1" dst="$2"; [[ ! -e "$src" ]]&&return 0; [[ -f "$src" && ! -L "$src" && "$(stat -c %h "$src")" == 1 ]]||{ echo "Unsafe env: $src" >&2;return 1;};rm -f "$dst";cp -p --no-dereference "$src" "$dst"; }
+cleanup_runners(){ local root="$1"; [[ -f "$root/backend/scripts/baseer-runner-cleanup.js" ]]&& (cd "$root/backend"&&BASEER_RUNNER_PROJECT_ROOT="$TARGET/backend" node scripts/baseer-runner-cleanup.js) || true; }
+verify_state(){ (cd "$STATE_DIR"&&sha256sum -c "$(basename "$STATE_CHECKSUMS")" >/dev/null); }
+restart_verify(){ local probe="${1:-false}" failed=0;for p in $PM2_NAMES;do pm2 restart "$p" --update-env >/dev/null 2>&1||failed=1;done;sleep "${BASEER_STABILITY_SECONDS:-8}";verify_pm2||failed=1;curl --fail --silent --show-error --retry 5 --retry-delay 2 --max-time 20 "$HEALTH_URL" >/dev/null||failed=1;if [[ "$probe" == true && "$failed" == 0 ]];then (cd "$TARGET/backend"&&npm run baseer:verify-worker-live-v1r23)||failed=1;(cd "$TARGET/backend"&&npm run test:api-postgres)||failed=1;fi;return "$failed"; }
+rollback_error(){ local code=$? failed=0;trap - ERR INT TERM;set +e;[[ "$SUCCESS" == 1 ]]&&return 0
+ if [[ "$SWAPPED" == 1 ]];then
+  verify_state||failed=1;python3 "$MANIFEST_TOOL" verify-runtime "$RELEASE" "$PREVIOUS_MANIFEST"||failed=1
+  copy_env "$TARGET/backend/.env" "$RELEASE/backend/.env"||failed=1;copy_env "$TARGET/frontend/.env" "$RELEASE/frontend/.env"||failed=1
+  for p in $PM2_NAMES;do pm2 stop "$p" >/dev/null 2>&1||failed=1;done;STOPPED=1;cleanup_runners "$TARGET"
+  verify_uploads_tree "$TARGET/backend/uploads"||failed=1
+  if [[ "$failed" == 0 && -d "$TARGET/backend/uploads" ]];then mkdir -p "$RELEASE/backend/uploads";rsync -a --delete "$TARGET/backend/uploads/" "$RELEASE/backend/uploads/"||failed=1;fi
+  verify_uploads_tree "$RELEASE/backend/uploads"||failed=1;[[ "$failed" == 0 ]]&&atomic_exchange "$TARGET" "$RELEASE"||failed=1
+  if [[ "$failed" == 0 ]]&&restart_verify false;then SWAPPED=0;STOPPED=0;else failed=1;fi
+  [[ "$failed" == 0 ]]||{ echo "CRITICAL: V1R23 automatic rollback failed." >&2;exit 91;}
+ elif [[ "$STOPPED" == 1 ]];then restart_verify false||exit 92;fi
+ rm -rf "$WORK";[[ "$SWAPPED" == 0 && -d "$RELEASE" ]]&&rm -rf "$RELEASE";echo "V1R23 deployment failed; verified V1R22 restored. Additive migrations may remain." >&2;exit "$code"; }
+trap rollback_error ERR INT TERM
+exec 9>"$LOCK";flock -n 9||{ echo "Another THRS deployment is running." >&2;exit 3; }
+EXPECTED="$(awk 'NF{print $1;exit}' "$SHA_FILE")";[[ "$EXPECTED" =~ ^[0-9a-fA-F]{64}$ ]]||exit 3;TRUSTED="${BASEER_TRUSTED_SOURCE_SHA256:-}";[[ "$TRUSTED" =~ ^[0-9a-fA-F]{64}$ && "${TRUSTED,,}" == "${EXPECTED,,}" ]]||{ echo "Trusted source SHA required." >&2;exit 3; };[[ "$(sha256sum "$ARCHIVE"|awk '{print $1}')" == "$EXPECTED" ]]||exit 3
+TOP="$(python3 - "$ARCHIVE" <<'PY'
+import posixpath,sys,tarfile
+seen=set();top=set()
+with tarfile.open(sys.argv[1],'r:*') as a:
+ for m in a.getmembers():
+  name=m.name
+  while name.startswith('./'):name=name[2:]
+  n=posixpath.normpath(name)
+  if not n or n=='.':continue
+  parts=n.split('/');top.add(parts[0])
+  if name.startswith('/') or n.startswith('../') or '..' in parts or '\\' in n or '\0' in n:raise SystemExit('unsafe path')
+  if n in seen:raise SystemExit('duplicate path')
+  seen.add(n)
+  if parts[-1]=='.env' or '.git' in parts or 'node_modules' in parts:raise SystemExit('forbidden member')
+  if not(m.isdir() or m.isfile()):raise SystemExit('non-regular member')
+if len(top)!=1:raise SystemExit('one top-level directory required')
+print(next(iter(top)))
+PY
+)"
+mkdir -p "$WORK" "$STATE_DIR";chmod 700 "$STATE_DIR";tar -xzf "$ARCHIVE" -C "$WORK" --no-same-owner;SOURCE="$WORK/$TOP";[[ -f "$SOURCE/backend/package.json" && -f "$SOURCE/frontend/package.json" ]]||exit 3;mv "$SOURCE" "$RELEASE";rm -rf "$WORK"
+# Exact V1R21 source gate before package installation or DB access.
+python3 "$RELEASE/scripts/baseer-v1r23-source-manifest.py" verify "$TARGET" "$RELEASE/BASELINE-THRS-BASEER-V1R22-SOURCE-MANIFEST.jsonl"
+copy_env "$TARGET/backend/.env" "$RELEASE/backend/.env";copy_env "$TARGET/frontend/.env" "$RELEASE/frontend/.env";rm -rf "$RELEASE/backend/uploads" "$RELEASE/backend/node_modules" "$RELEASE/frontend/node_modules" "$RELEASE/frontend/build"
+(cd "$RELEASE/backend";npm ci;npm run prisma:generate;npm run verify;npm run baseer:verify-v1r23;npm run baseer:verify-schema-v1r23)
+(cd "$RELEASE/frontend";npm ci;npm run build;test -f build/index.html)
+cp -p "$RELEASE/scripts/baseer-v1r21-runtime-manifest.py" "$MANIFEST_TOOL";chmod 500 "$MANIFEST_TOOL";python3 "$MANIFEST_TOOL" generate-runtime "$TARGET" "$PREVIOUS_MANIFEST";python3 "$MANIFEST_TOOL" generate-runtime "$RELEASE" "$CURRENT_MANIFEST"
+printf 'TARGET=%q\nPREVIOUS_RELEASE=%q\nHEALTH_URL=%q\nPM2_NAMES=%q\n' "$TARGET" "$RELEASE" "$HEALTH_URL" "$PM2_NAMES">"$STATE_DIR/deployment.env";(cd "$STATE_DIR"&&sha256sum "$(basename "$PREVIOUS_MANIFEST")" "$(basename "$CURRENT_MANIFEST")" "$(basename "$MANIFEST_TOOL")" deployment.env>"$(basename "$STATE_CHECKSUMS")");chmod 400 "$PREVIOUS_MANIFEST" "$CURRENT_MANIFEST" "$STATE_CHECKSUMS" "$STATE_DIR/deployment.env"
+verify_state;verify_pm2;for p in $PM2_NAMES;do pm2 stop "$p" >/dev/null;done;STOPPED=1;cleanup_runners "$RELEASE";verify_state;python3 "$MANIFEST_TOOL" verify-runtime "$TARGET" "$PREVIOUS_MANIFEST";python3 "$MANIFEST_TOOL" verify-runtime "$RELEASE" "$CURRENT_MANIFEST"
+verify_uploads_tree "$TARGET/backend/uploads";if [[ -d "$TARGET/backend/uploads" ]];then mkdir -p "$RELEASE/backend/uploads";rsync -a --delete "$TARGET/backend/uploads/" "$RELEASE/backend/uploads/";fi;verify_uploads_tree "$RELEASE/backend/uploads";atomic_exchange "$TARGET" "$RELEASE";SWAPPED=1
+# DB changes happen only after the atomic source swap, while services are stopped.
+(cd "$TARGET/backend";npm run prisma:migrate;npm run baseer:verify-postgres-v1r18;npm run baseer:verify-postgres-v1r20;npm run test:postgres)
+for p in $PM2_NAMES;do pm2 restart "$p" --update-env >/dev/null;done;STOPPED=0;sleep "${BASEER_STABILITY_SECONDS:-8}";verify_pm2;curl --fail --silent --show-error --retry 5 --retry-delay 2 --max-time 20 "$HEALTH_URL" >/dev/null;(cd "$TARGET/backend";npm run baseer:verify-worker-live-v1r23;npm run test:api-postgres)
+SUCCESS=1;trap - ERR INT TERM;echo "BASEER_V1R23_FULL_SOURCE_APPLY_OK";echo "STATE_DIR=$STATE_DIR";echo "PREVIOUS_RELEASE=$RELEASE"
