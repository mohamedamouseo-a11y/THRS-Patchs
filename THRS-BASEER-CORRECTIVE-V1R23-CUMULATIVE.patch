index 0000000..1f58d0c
--- /dev/null
+++ b/backend/scripts/verify-baseer-worker-live-v1r23.js
@@ -0,0 +1,26 @@
+'use strict';
+require('dotenv').config();
+const crypto = require('crypto');
+const prisma = require('../src/config/database');
+const { positiveMilliseconds } = require('../src/services/baseer/worker-isolation');
+const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+async function main() {
+  const timeoutMs = Math.min(120000, positiveMilliseconds(process.env.BASEER_WORKER_LIVENESS_TIMEOUT_MS, 30000));
+  const nonce=crypto.randomUUID();
+  const ack=`BASEER_WORKER_V1R23_ACK:${nonce}`;
+  const job = await prisma.baseerJob.create({ data: { jobType: 'WORKER_HEALTH_PROBE_V1R23', payload: { nonce, workerVersion:'V1R23', requestedAt: new Date().toISOString() }, maxAttempts: 1, runAt: new Date() } });
+  const deadline = Date.now() + timeoutMs;
+  try {
+    while (Date.now() < deadline) {
+      const current = await prisma.baseerJob.findUnique({ where: { id: job.id }, select: { status: true, lastError: true } });
+      if (current?.status === 'SUCCEEDED' && current.lastError === ack) { console.log(`BASEER_V1R23_WORKER_LIVENESS_PASS job=${job.id}`); return; }
+      if (current?.status === 'SUCCEEDED') throw new Error('A non-V1R23 worker consumed the health probe without the required acknowledgement.');
+      if (['FAILED', 'UNKNOWN'].includes(current?.status)) throw new Error(`Worker health probe ${current.status}: ${current.lastError || 'unknown error'}`);
+      await wait(500);
