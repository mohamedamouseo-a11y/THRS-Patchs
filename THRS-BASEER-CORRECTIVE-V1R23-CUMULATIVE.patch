+test('V1R23 auto rollback restores V1R22 after health failure',{skip:process.platform!=='linux'},()=>{const f=fixture('failonce');try{const a=spawnSync('bash',[apply,f.archive,f.shaFile,f.target,'http://health'],{env:f.env,encoding:'utf8',timeout:30000});assert.notEqual(a.status,0);assert.match(marker(f.target),/OLD/);assert.match(a.stderr,/verified V1R22 restored/i);}finally{fs.rmSync(f.r,{recursive:true,force:true});}});
