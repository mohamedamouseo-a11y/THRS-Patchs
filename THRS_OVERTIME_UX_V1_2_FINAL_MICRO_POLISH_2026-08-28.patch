+/* THRS Overtime V1.2 Final Micro-Polish
+   Visual-only overrides layered after V1 and V1.1.
+   Scope is intentionally limited to three final UX refinements:
+   compact tabs, page-level table scrolling, and compact rate configuration. */
+
+/* 1) Make the Requests / Monthly Summary switch a true compact segmented control. */
+.thrs-overtime-v1 .thrs-ot-tabs {
+  display: inline-flex !important;
+  width: max-content !important;
+  max-width: 100% !important;
+  align-self: flex-start !important;
+  justify-self: start !important;
+  grid-template-columns: none !important;
+  gap: 3px !important;
+  padding: 4px !important;
+  margin: 0 0 14px !important;
+  border-radius: 12px !important;
+  background: #f7f9fc !important;
+}
+
+.thrs-overtime-v1 .thrs-ot-tabs button {
+  flex: 0 0 auto !important;
+  min-width: 0 !important;
+  width: auto !important;
+  min-height: 34px !important;
+  height: 34px !important;
+  padding: 0 15px !important;
+}
+
+/* 2) Remove the nested vertical scroll region from the requests table.
+      The page remains the vertical scroll owner; horizontal overflow is kept for narrow widths. */
+.thrs-overtime-v1 .thrs-ot-table-wrap {
+  max-height: none !important;
+  height: auto !important;
+  overflow-x: auto !important;
+  overflow-y: visible !important;
+  overscroll-behavior: auto !important;
+  scrollbar-gutter: auto !important;
+}
+
+.thrs-overtime-v1 .thrs-ot-table-card {
+  overflow: visible !important;
+}
+
+.thrs-overtime-v1 .thrs-ot-table-card > div {
+  overflow: visible !important;
+}
+
+/* Keep card rounding while allowing the table to participate in normal page flow. */
+.thrs-overtime-v1 .thrs-ot-section-head {
+  border-radius: 17px 17px 0 0;
+}
+
+.thrs-overtime-v1 .thrs-ot-pagination {
+  border-radius: 0 0 17px 17px;
+}
+
+/* 3) Turn Overtime multipliers into a compact horizontal reference bar. */
+.thrs-overtime-v1 .thrs-ot-rate-card {
+  min-height: 0 !important;
+  margin-top: 14px !important;
+  padding: 0 !important;
+}
+
+.thrs-overtime-v1 .thrs-ot-rate-card > div {
+  min-height: 92px !important;
+  display: flex !important;
+  align-items: center !important;
+  justify-content: space-between !important;
+  gap: 20px !important;
+  padding: 12px 16px !important;
+}
+
+.thrs-overtime-v1 .thrs-ot-rate-card > div > div:first-child {
+  min-width: 0;
+}
+
+.thrs-overtime-v1 .thrs-ot-rate-card h2 {
+  margin: 1px 0 2px !important;
+  font-size: 15px !important;
+  line-height: 1.2;
+}
+
+.thrs-overtime-v1 .thrs-ot-rate-card p {
+  margin: 2px 0 0 !important;
+  line-height: 1.3;
+}
+
+.thrs-overtime-v1 .thrs-ot-rate-values {
+  flex: 0 0 auto;
+  display: grid !important;
+  grid-template-columns: repeat(2, minmax(118px, 1fr)) !important;
+  gap: 8px !important;
+}
+
+.thrs-overtime-v1 .thrs-ot-rate-values > span {
+  min-width: 118px;
+  padding: 7px 11px !important;
+}
+
+.thrs-overtime-v1 .thrs-ot-rate-values strong {
+  margin-top: 1px !important;
+  font-size: 16px !important;
+}
+
+@media (max-width: 760px) {
+  .thrs-overtime-v1 .thrs-ot-tabs {
+    display: flex !important;
+    width: 100% !important;
+  }
+
+  .thrs-overtime-v1 .thrs-ot-tabs button {
+    flex: 1 1 0 !important;
+  }
+
+  .thrs-overtime-v1 .thrs-ot-rate-card > div {
+    min-height: 0 !important;
+    align-items: stretch !important;
+    flex-direction: column !important;
+    gap: 10px !important;
+  }
+
+  .thrs-overtime-v1 .thrs-ot-rate-values {
+    width: 100%;
+    grid-template-columns: 1fr 1fr !important;
+  }
+}
