+++ b/backend/prisma/migrations/20260829000400_central_governance_approval/migration.sql
@@ -0,0 +1,36 @@
+-- THRS Central Governance & Approval — Phase 4
+-- Sensitive actions are queued and executed only after explicit approval.
+
+CREATE TABLE "governance_actions" (
+  "id" TEXT NOT NULL,
+  "actionType" TEXT NOT NULL,
+  "status" TEXT NOT NULL DEFAULT 'PENDING',
+  "module" TEXT NOT NULL DEFAULT 'SYSTEM_GOVERNANCE',
+  "entityType" TEXT,
+  "entityId" TEXT,
+  "targetAuditId" TEXT,
+  "targetDeletionId" TEXT,
+  "reason" TEXT NOT NULL,
+  "requestedById" TEXT,
+  "requestedByName" TEXT,
+  "requestedByEmail" TEXT,
+  "requestedByRole" TEXT,
+  "requestedAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  "reviewedById" TEXT,
+  "reviewedByName" TEXT,
+  "reviewedByEmail" TEXT,
+  "reviewedByRole" TEXT,
+  "reviewedAt" TIMESTAMP(3),
+  "reviewNote" TEXT,
+  "executionResult" JSONB,
+  "metadata" JSONB,
+  "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  "updatedAt" TIMESTAMP(3) NOT NULL,
+  CONSTRAINT "governance_actions_pkey" PRIMARY KEY ("id")
+);
+
+CREATE INDEX "governance_actions_status_createdAt_idx" ON "governance_actions"("status", "createdAt");
+CREATE INDEX "governance_actions_actionType_status_idx" ON "governance_actions"("actionType", "status");
+CREATE INDEX "governance_actions_targetAuditId_idx" ON "governance_actions"("targetAuditId");
+CREATE INDEX "governance_actions_targetDeletionId_idx" ON "governance_actions"("targetDeletionId");
+CREATE INDEX "governance_actions_requestedById_createdAt_idx" ON "governance_actions"("requestedById", "createdAt");
diff --git a/backend/src/services/governance.service.js b/backend/src/services/governance.service.js
new file mode 100644
--- /dev/null
+++ b/backend/src/services/governance.service.js
@@ -0,0 +1,230 @@
+'use strict';
+
+const prisma = require('../config/database');
+const {
+  actorSnapshot,
+  clientIp,
+  recordAuditEvent,
+  sanitizeForAudit,
+} = require('./audit.service');
+const { getRecoveryStatus, undoAuditEvent } = require('./recovery.service');
+const { reviewDeletion } = require('./deletion.service');
+
+const ACTION_UNDO = 'UNDO_AUDIT';
+const ACTION_CONFIRM_DELETE = 'CONFIRM_DELETE';
+const SUPPORTED_ACTIONS = [ACTION_UNDO, ACTION_CONFIRM_DELETE];
+
+function httpError(statusCode, message, code) {
+  const error = new Error(message);
+  error.statusCode = statusCode;
+  error.code = code || 'GOVERNANCE_ERROR';
+  return error;
+}
+
+function requiredReason(value, label = 'Reason') {
+  const text = String(value || '').trim();
+  if (text.length < 3) throw httpError(400, `${label} is required.`, 'GOVERNANCE_REASON_REQUIRED');
+  return text.slice(0, 1000);
+}
+
+async function validateTarget(actionType, targetId) {
+  if (actionType === ACTION_UNDO) {
+    const status = await getRecoveryStatus(targetId);
+    if (!status.available) {
+      throw httpError(409, `Undo is not available: ${status.reason || 'not recoverable'}`, 'UNDO_NOT_AVAILABLE');
+    }
+    return {
+      module: status.event.module || 'SYSTEM_GOVERNANCE',
+      entityType: status.event.entity || null,
+      entityId: status.event.entityId || null,
+      targetAuditId: status.event.id,
+      targetDeletionId: null,
+      metadata: { originalAction: status.event.action },
+    };
+  }
+
+  const deletion = await prisma.deletionRecord.findUnique({ where: { id: String(targetId) } });
+  if (!deletion) throw httpError(404, 'Deletion record not found.', 'DELETION_RECORD_NOT_FOUND');
+  if (!deletion.isActive || deletion.status === 'CONFIRMED') {
+    throw httpError(409, 'Deletion record is not pending confirmation.', 'DELETE_CONFIRM_NOT_AVAILABLE');
+  }
+  return {
+    module: deletion.module || 'SYSTEM_GOVERNANCE',
+    entityType: deletion.entityType || null,
+    entityId: deletion.entityId || null,
+    targetAuditId: null,
+    targetDeletionId: deletion.id,
+    metadata: { deletionStatus: deletion.status },
+  };
+}
+
+async function requestGovernanceAction(req, input = {}) {
+  const actionType = String(input.actionType || '').trim().toUpperCase();
+  if (!SUPPORTED_ACTIONS.includes(actionType)) {
+    throw httpError(400, 'Unsupported governance action.', 'GOVERNANCE_ACTION_UNSUPPORTED');
+  }
+
+  const reason = requiredReason(input.reason, 'Governance reason');
+  const targetId = String(
+    actionType === ACTION_UNDO ? input.targetAuditId : input.targetDeletionId
+  ).trim();
+  if (!targetId) throw httpError(400, 'Governance target is required.', 'GOVERNANCE_TARGET_REQUIRED');
+
+  const target = await validateTarget(actionType, targetId);
+  const duplicateWhere = {
+    actionType,
+    status: 'PENDING',
+    ...(actionType === ACTION_UNDO
+      ? { targetAuditId: target.targetAuditId }
+      : { targetDeletionId: target.targetDeletionId }),
+  };
+  const existing = await prisma.governanceAction.findFirst({ where: duplicateWhere });
+  if (existing) return { request: existing, alreadyPending: true };
+
+  const actor = actorSnapshot(req);
+  const request = await prisma.governanceAction.create({
+    data: {
+      actionType,
+      status: 'PENDING',
+      module: target.module,
+      entityType: target.entityType,
+      entityId: target.entityId ? String(target.entityId) : null,
+      targetAuditId: target.targetAuditId,
+      targetDeletionId: target.targetDeletionId,
+      reason,
+      requestedById: actor.userId || null,
+      requestedByName: actor.actorName || null,
+      requestedByEmail: actor.actorEmail || null,
+      requestedByRole: actor.actorRole || null,
+      metadata: sanitizeForAudit(target.metadata),
+    },
+  });
+
+  await recordAuditEvent({
+    ...actor,
+    action: 'GOVERNANCE_REQUEST',
+    module: 'SYSTEM_GOVERNANCE',
+    entity: 'GOVERNANCE_ACTION',
+    entityId: request.id,
+    summary: `Requested ${actionType}`,
+    afterState: { status: request.status, actionType, targetId },
+    metadata: { reason, targetAuditId: target.targetAuditId, targetDeletionId: target.targetDeletionId },
+    requestId: req.auditRequestId || null,
+    method: req.method || 'POST',
+    route: req.originalUrl || null,
+    outcome: 'SUCCESS',
+    statusCode: 202,
+    source: actor.source || 'WEB',
+    reversible: false,
+    ipAddress: clientIp(req),
+    userAgent: req.get?.('user-agent') || null,
+  });
+
+  return { request, alreadyPending: false };
+}
+
+async function listGovernanceActions(query = {}) {
+  const page = Math.max(1, Number.parseInt(query.page, 10) || 1);
+  const pageSize = Math.min(100, Math.max(10, Number.parseInt(query.pageSize, 10) || 25));
+  const where = {};
+  if (query.status) where.status = String(query.status).trim().toUpperCase();
+  if (query.actionType) where.actionType = String(query.actionType).trim().toUpperCase();
+  const [total, requests] = await Promise.all([
+    prisma.governanceAction.count({ where }),
+    prisma.governanceAction.findMany({
+      where,
+      orderBy: { createdAt: 'desc' },
+      skip: (page - 1) * pageSize,
+      take: pageSize,
+    }),
+  ]);
+  return {
+    requests,
+    pagination: { page, pageSize, total, pages: Math.max(1, Math.ceil(total / pageSize)) },
+  };
+}
+
+async function getGovernanceSummary() {
+  const [pending, approved, rejected, total] = await Promise.all([
+    prisma.governanceAction.count({ where: { status: 'PENDING' } }),
+    prisma.governanceAction.count({ where: { status: 'APPROVED' } }),
+    prisma.governanceAction.count({ where: { status: 'REJECTED' } }),
+    prisma.governanceAction.count(),
+  ]);
+  return { pending, approved, rejected, total };
+}
+
+async function reviewGovernanceAction(req, id, decision, note) {
+  const request = await prisma.governanceAction.findUnique({ where: { id: String(id) } });
+  if (!request) throw httpError(404, 'Governance request not found.', 'GOVERNANCE_REQUEST_NOT_FOUND');
+  if (request.status !== 'PENDING') {
+    throw httpError(409, 'Governance request was already reviewed.', 'GOVERNANCE_ALREADY_REVIEWED');
+  }
+
+  const normalizedDecision = String(decision || '').trim().toUpperCase();
+  if (!['APPROVE', 'REJECT'].includes(normalizedDecision)) {
+    throw httpError(400, 'Invalid governance decision.', 'GOVERNANCE_DECISION_INVALID');
+  }
+  const reviewNote = requiredReason(note, 'Review note');
+  const actor = actorSnapshot(req);
+
+  let result = null;
+  if (normalizedDecision === 'APPROVE') {
+    if (request.actionType === ACTION_UNDO) {
+      result = await undoAuditEvent(req, request.targetAuditId, `Governance approval: ${reviewNote}. Request reason: ${request.reason}`);
+    } else if (request.actionType === ACTION_CONFIRM_DELETE) {
+      result = await reviewDeletion(req, request.targetDeletionId, 'CONFIRM', reviewNote);
+    } else {
+      throw httpError(409, 'Action is no longer supported.', 'GOVERNANCE_ACTION_UNSUPPORTED');
+    }
+  }
+
+  const reviewed = await prisma.governanceAction.update({
+    where: { id: request.id },
+    data: {
+      status: normalizedDecision === 'APPROVE' ? 'APPROVED' : 'REJECTED',
+      reviewedById: actor.userId || null,
+      reviewedByName: actor.actorName || null,
+      reviewedByEmail: actor.actorEmail || null,
+      reviewedByRole: actor.actorRole || null,
+      reviewedAt: new Date(),
+      reviewNote,
+      executionResult: result ? sanitizeForAudit(result) : null,
+    },
+  });
+
+  await recordAuditEvent({
+    ...actor,
+    action: normalizedDecision === 'APPROVE' ? 'GOVERNANCE_APPROVE' : 'GOVERNANCE_REJECT',
+    module: 'SYSTEM_GOVERNANCE',
+    entity: 'GOVERNANCE_ACTION',
+    entityId: request.id,
+    summary: `${normalizedDecision} ${request.actionType}`,
+    beforeState: { status: request.status },
+    afterState: { status: reviewed.status },
+    metadata: { reviewNote, targetAuditId: request.targetAuditId, targetDeletionId: request.targetDeletionId },
+    requestId: req.auditRequestId || null,
+    method: req.method || 'POST',
+    route: req.originalUrl || null,
+    outcome: 'SUCCESS',
+    statusCode: 200,
+    source: actor.source || 'WEB',
+    reversible: false,
+    ipAddress: clientIp(req),
+    userAgent: req.get?.('user-agent') || null,
+  });
+
+  return { request: reviewed, result };
+}
+
+module.exports = {
+  SUPPORTED_ACTIONS,
+  requestGovernanceAction,
+  listGovernanceActions,
+  getGovernanceSummary,
+  reviewGovernanceAction,
+};
diff --git a/backend/src/controllers/governance.controller.js b/backend/src/controllers/governance.controller.js
new file mode 100644
--- /dev/null
+++ b/backend/src/controllers/governance.controller.js
@@ -0,0 +1,51 @@
+'use strict';
+
+const {
+  listGovernanceActions,
+  getGovernanceSummary,
+  reviewGovernanceAction,
+} = require('../services/governance.service');
+
+function sendError(res, error, fallback) {
+  return res.status(error.statusCode || 500).json({
+    success: false,
+    code: error.code || 'GOVERNANCE_ERROR',
+    message: error.message || fallback,
+  });
+}
+
+async function summary(req, res) {
+  try {
+    return res.json({ success: true, data: await getGovernanceSummary() });
+  } catch (error) {
+    return sendError(res, error, 'Failed to load governance summary');
+  }
+}
+
+async function requests(req, res) {
+  try {
+    return res.json({ success: true, data: await listGovernanceActions(req.query) });
+  } catch (error) {
+    return sendError(res, error, 'Failed to load governance requests');
+  }
+}
+
+async function approve(req, res) {
+  try {
+    const data = await reviewGovernanceAction(req, req.params.id, 'APPROVE', req.body?.note);
+    return res.json({ success: true, message: 'Governance request approved and executed.', data });
+  } catch (error) {
+    return sendError(res, error, 'Failed to approve governance request');
+  }
+}
+
+async function reject(req, res) {
+  try {
+    const data = await reviewGovernanceAction(req, req.params.id, 'REJECT', req.body?.note);
+    return res.json({ success: true, message: 'Governance request rejected.', data });
+  } catch (error) {
+    return sendError(res, error, 'Failed to reject governance request');
+  }
+}
+
+module.exports = { summary, requests, approve, reject };
