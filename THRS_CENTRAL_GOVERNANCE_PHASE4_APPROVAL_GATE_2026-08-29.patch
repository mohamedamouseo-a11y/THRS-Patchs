+'use strict';
+
+const express = require('express');
+const router = express.Router();
+const authMiddleware = require('../middleware/auth.middleware');
+const governanceController = require('../controllers/governance.controller');
+const { isReservedSuperAdmin } = require('../utils/superAdmin');
+
+function primarySuperAdminOnly(req, res, next) {
+  if (req.user?.role !== 'SUPER_ADMIN' || !isReservedSuperAdmin(req.user)) {
+    return res.status(403).json({
+      success: false,
+      message: 'Pending Actions is limited to the primary Super Admin.',
+    });
+  }
+  return next();
+}
+
+router.use(authMiddleware);
+router.use(primarySuperAdminOnly);
+router.get('/summary', governanceController.summary);
+router.get('/requests', governanceController.requests);
+router.post('/requests/:id/approve', governanceController.approve);
+router.post('/requests/:id/reject', governanceController.reject);
+
+module.exports = router;
