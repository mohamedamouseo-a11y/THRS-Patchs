+++ b/backend/src/controllers/recovery.controller.js
@@ -0,0 +1,65 @@
+'use strict';
+
+const {
+  getRecoveryStatus,
+  listRecoverableEvents,
+  getRecoverySummary,
+  undoAuditEvent,
+} = require('../services/recovery.service');
+
+function sendError(res, error, fallback) {
+  return res.status(error.statusCode || 500).json({
+    success: false,
+    code: error.code || 'RECOVERY_ERROR',
+    message: error.message || fallback,
+  });
+}
+
+async function summary(req, res) {
+  try {
+    return res.json({ success: true, data: await getRecoverySummary() });
+  } catch (error) {
+    console.error('Recovery summary error:', error);
+    return sendError(res, error, 'Failed to load recovery summary');
+  }
+}
+
+async function events(req, res) {
+  try {
+    return res.json({ success: true, data: await listRecoverableEvents(req.query) });
+  } catch (error) {
+    console.error('Recovery events error:', error);
+    return sendError(res, error, 'Failed to load recoverable events');
+  }
+}
+
+async function status(req, res) {
+  try {
+    const result = await getRecoveryStatus(req.params.auditId);
+    return res.json({ success: true, data: result });
+  } catch (error) {
+    return sendError(res, error, 'Failed to load recovery status');
+  }
+}
+
+async function undo(req, res) {
+  try {
+    const result = await undoAuditEvent(req, req.params.auditId, req.body?.note);
+    return res.json({
+      success: true,
+      message: 'Action undone. The original audit event was preserved and a reversal event was added.',
+      data: result,
+    });
+  } catch (error) {
+    return sendError(res, error, 'Failed to undo audit event');
+  }
+}
+
+module.exports = { summary, events, status, undo };
