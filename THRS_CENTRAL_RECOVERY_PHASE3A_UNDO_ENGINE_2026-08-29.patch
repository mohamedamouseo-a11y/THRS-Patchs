+++ b/frontend/src/pages/RecoveryCenter.jsx
@@ -0,0 +1,256 @@
+import React, { useCallback, useEffect, useState } from 'react';
+import api from '../services/api';
+import '../styles/thrs-recovery-center.css';
+
+function prettyToken(value) {
+  return String(value || '—')
+    .replace(/_/g, ' ')
+    .toLowerCase()
+    .replace(/\b\w/g, (char) => char.toUpperCase());
+}
+
+function formatDate(value) {
+  if (!value) return '—';
+  const date = new Date(value);
+  if (Number.isNaN(date.getTime())) return '—';
+  return date.toLocaleString(undefined, {
+    year: 'numeric', month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit',
+  });
+}
+
+const RecoveryCenter = () => {
+  const [summary, setSummary] = useState({ eligibleEvents: 0, completedRecoveries: 0, remaining: 0, latestRecoveryAt: null });
+  const [events, setEvents] = useState([]);
+  const [pagination, setPagination] = useState({ page: 1, pageSize: 25, total: 0, pages: 1 });
+  const [moduleName, setModuleName] = useState('');
+  const [selected, setSelected] = useState(null);
+  const [undoTarget, setUndoTarget] = useState(null);
+  const [note, setNote] = useState('');
+  const [loading, setLoading] = useState(true);
+  const [submitting, setSubmitting] = useState(false);
+  const [error, setError] = useState('');
+  const [notice, setNotice] = useState('');
+
+  const loadSummary = useCallback(async () => {
+    try {
+      const response = await api.get('/recovery/summary');
+      setSummary(response?.data || {});
+    } catch (requestError) {
+      console.error('Recovery summary failed:', requestError);
+    }
+  }, []);
+
+  const loadEvents = useCallback(async (page = 1, pageSize = pagination.pageSize) => {
+    setLoading(true);
+    setError('');
+    try {
+      const params = { page, pageSize };
+      if (moduleName.trim()) params.module = moduleName.trim().toUpperCase();
+      const response = await api.get('/recovery/events', { params });
+      setEvents(response?.data?.events || []);
+      setPagination(response?.data?.pagination || { page, pageSize, total: 0, pages: 1 });
+    } catch (requestError) {
+      setError(requestError?.message || 'Failed to load recoverable activity.');
+    } finally {
+      setLoading(false);
+    }
+  }, [moduleName, pagination.pageSize]);
+
+  useEffect(() => { loadSummary(); }, [loadSummary]);
+  useEffect(() => { loadEvents(1, pagination.pageSize); }, [loadEvents, pagination.pageSize]);
+
+  const submitUndo = async () => {
+    if (!undoTarget || submitting) return;
+    setSubmitting(true);
+    setError('');
+    setNotice('');
+    try {
+      await api.post(`/recovery/events/${undoTarget.id}/undo`, { note: note.trim() || undefined });
+      setNotice('Recovery completed. The source record is visible again and the original audit event was preserved.');
+      setUndoTarget(null);
+      setNote('');
+      setSelected(null);
+      await Promise.all([loadSummary(), loadEvents(pagination.page, pagination.pageSize)]);
+    } catch (requestError) {
+      setError(requestError?.message || 'Unable to undo this activity.');
+    } finally {
+      setSubmitting(false);
+    }
+  };
+
+  return (
+    <div className="thrs-recovery-center">
+      <header className="thrs-recovery-hero">
+        <div>
+          <span className="thrs-recovery-eyebrow">SYSTEM GOVERNANCE · PHASE 3A</span>
+          <h1>Recovery Center</h1>
+          <p>Controlled reversal of supported actions without rewriting the immutable audit history.</p>
+        </div>
+        <span className="thrs-recovery-badge">UNDO ENGINE ACTIVE</span>
+      </header>
+
+      <section className="thrs-recovery-kpis">
+        <article><span>Eligible events</span><strong>{summary.eligibleEvents || 0}</strong><small>Supported reversible audit events</small></article>
+        <article><span>Completed recoveries</span><strong>{summary.completedRecoveries || 0}</strong><small>Immutable reversal records</small></article>
+        <article><span>Remaining</span><strong>{summary.remaining || 0}</strong><small>Eligible events not yet reversed</small></article>
+        <article><span>Latest recovery</span><strong className="is-date">{formatDate(summary.latestRecoveryAt)}</strong><small>Most recent completed undo</small></article>
+      </section>
+
+      <section className="thrs-recovery-note">
+        <div>
+          <strong>Original history is never rewritten.</strong>
+          <span>Undo creates a new reversal audit event and a separate RecoveryRecord.</span>
+        </div>
+        <span>Phase 3A · Soft Delete Recovery</span>
+      </section>
+
+      {notice && <div className="thrs-recovery-notice">{notice}</div>}
+      {error && <div className="thrs-recovery-error">{error}</div>}
+
+      <section className="thrs-recovery-card">
+        <div className="thrs-recovery-toolbar">
+          <div>
+            <span className="thrs-recovery-eyebrow">RECOVERABLE LEDGER</span>
+            <h2>Supported Activity</h2>
+            <p>{pagination.total || 0} reversible governance events</p>
+          </div>
+          <div className="thrs-recovery-filter">
+            <input value={moduleName} onChange={(event) => setModuleName(event.target.value)} placeholder="Module e.g. RECRUITMENT" />
+            <button type="button" onClick={() => loadEvents(1)}>Apply</button>
+          </div>
+        </div>
+
+        <div className="thrs-recovery-table-wrap">
+          <table className="thrs-recovery-table">
+            <thead><tr><th>Time</th><th>Actor</th><th>Original action</th><th>Target</th><th>Recovery state</th><th /></tr></thead>
+            <tbody>
+              {loading && <tr><td colSpan="6" className="thrs-recovery-empty">Loading recovery ledger…</td></tr>}
+              {!loading && events.length === 0 && <tr><td colSpan="6" className="thrs-recovery-empty">No supported reversible events found.</td></tr>}
+              {!loading && events.map((event) => (
+                <tr key={event.id}>
+                  <td><strong>{formatDate(event.createdAt)}</strong><small>{event.requestId ? event.requestId.slice(0, 8) : 'No request ID'}</small></td>
+                  <td><strong>{event.actorName || event.actorEmail || 'System actor'}</strong><small>{prettyToken(event.actorRole)}</small></td>
+                  <td><span className="thrs-recovery-action">{prettyToken(event.action)}</span><small>{event.method || '—'}</small></td>
+                  <td><strong>{prettyToken(event.module)}</strong><small>{event.entity || '—'} · {String(event.entityId || '—').slice(0, 12)}</small></td>
+                  <td>
+                    <span className={`thrs-recovery-state ${event.recovery ? 'is-complete' : event.recoveryAvailable ? 'is-ready' : 'is-locked'}`}>
+                      {event.recovery ? 'Recovered' : event.recoveryAvailable ? 'Undo available' : 'Inactive'}
+                    </span>
+                  </td>
+                  <td className="thrs-recovery-actions">
+                    <button type="button" onClick={() => setSelected(event)}>Inspect</button>
+                    {event.recoveryAvailable && <button type="button" className="is-undo" onClick={() => { setUndoTarget(event); setNote(''); }}>Undo</button>}
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+
+        <footer className="thrs-recovery-pagination">
+          <span>Page {pagination.page} of {pagination.pages}</span>
+          <div>
+            <button type="button" disabled={pagination.page <= 1 || loading} onClick={() => loadEvents(pagination.page - 1)}>Previous</button>
+            <button type="button" disabled={pagination.page >= pagination.pages || loading} onClick={() => loadEvents(pagination.page + 1)}>Next</button>
+          </div>
+        </footer>
+      </section>
+
+      {selected && (
+        <div className="thrs-recovery-backdrop" onMouseDown={() => setSelected(null)}>
+          <aside className="thrs-recovery-drawer" onMouseDown={(event) => event.stopPropagation()}>
+            <div className="thrs-recovery-drawer-head">
+              <div><span className="thrs-recovery-eyebrow">ORIGINAL AUDIT EVENT</span><h2>{prettyToken(selected.action)} · {prettyToken(selected.module)}</h2><p>{selected.summary || 'Recorded reversible activity'}</p></div>
+              <button type="button" onClick={() => setSelected(null)}>×</button>
+            </div>
+            <div className="thrs-recovery-detail-grid">
+              <div><span>Audit ID</span><strong>{selected.id}</strong></div>
+              <div><span>Actor</span><strong>{selected.actorName || selected.actorEmail || 'System actor'}</strong></div>
+              <div><span>Entity</span><strong>{selected.entity || '—'} · {selected.entityId || '—'}</strong></div>
+              <div><span>Recovery</span><strong>{selected.recovery ? 'Already recovered' : selected.recoveryAvailable ? 'Available' : 'Unavailable'}</strong></div>
+            </div>
+            <pre className="thrs-recovery-json">{JSON.stringify({ beforeState: selected.beforeState, afterState: selected.afterState, metadata: selected.metadata }, null, 2)}</pre>
+            {selected.recoveryAvailable && <button className="thrs-recovery-drawer-undo" type="button" onClick={() => { setUndoTarget(selected); setSelected(null); }}>Undo this action</button>}
+          </aside>
+        </div>
+      )}
+
+      {undoTarget && (
+        <div className="thrs-recovery-backdrop">
+          <div className="thrs-recovery-modal">
+            <span className="thrs-recovery-eyebrow">CONTROLLED REVERSAL</span>
+            <h2>Undo {prettyToken(undoTarget.action)}?</h2>
+            <p>The original audit event will remain unchanged. THRS will restore the hidden source record and create a new UNDO event referencing it.</p>
+            <label><span>Recovery note · optional</span><textarea value={note} onChange={(event) => setNote(event.target.value)} maxLength={1000} placeholder="Reason or governance note…" /></label>
+            <div className="thrs-recovery-modal-actions">
+              <button type="button" disabled={submitting} onClick={() => { setUndoTarget(null); setNote(''); }}>Cancel</button>
+              <button type="button" className="is-primary" disabled={submitting} onClick={submitUndo}>{submitting ? 'Reversing…' : 'Confirm Undo'}</button>
+            </div>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+};
+
+export default RecoveryCenter;
