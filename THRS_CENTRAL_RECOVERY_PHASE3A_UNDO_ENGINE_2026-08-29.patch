+'use strict';
+
+const express = require('express');
+const router = express.Router();
+const authMiddleware = require('../middleware/auth.middleware');
+const recoveryController = require('../controllers/recovery.controller');
+const { isReservedSuperAdmin } = require('../utils/superAdmin');
+
+function primarySuperAdminOnly(req, res, next) {
+  if (req.user?.role !== 'SUPER_ADMIN' || !isReservedSuperAdmin(req.user)) {
+    return res.status(403).json({
+      success: false,
+      message: 'Recovery Center is limited to the primary Super Admin.',
+    });
+  }
+  return next();
+}
+
+router.use(authMiddleware);
+router.use(primarySuperAdminOnly);
+
+router.get('/summary', recoveryController.summary);
+router.get('/events', recoveryController.events);
+router.get('/events/:auditId/status', recoveryController.status);
+router.post('/events/:auditId/undo', recoveryController.undo);
+
+module.exports = router;
