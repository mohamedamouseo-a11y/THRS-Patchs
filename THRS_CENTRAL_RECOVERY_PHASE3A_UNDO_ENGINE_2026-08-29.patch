+-- THRS Central Recovery / Undo Engine — Phase 3A
+-- Immutable audit history is preserved. Reversals are stored as new audit events.
+
+CREATE TABLE "recovery_records" (
+  "id" TEXT NOT NULL,
+  "originalAuditId" TEXT NOT NULL,
+  "reversalAuditId" TEXT NOT NULL,
+  "module" TEXT NOT NULL,
+  "entityType" TEXT,
+  "entityId" TEXT,
+  "originalAction" TEXT NOT NULL,
+  "status" TEXT NOT NULL DEFAULT 'COMPLETED',
+  "note" TEXT,
+  "requestedById" TEXT,
+  "requestedByName" TEXT,
+  "requestedByEmail" TEXT,
+  "requestedByRole" TEXT,
+  "requestedAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  "metadata" JSONB,
+  "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  "updatedAt" TIMESTAMP(3) NOT NULL,
+  CONSTRAINT "recovery_records_pkey" PRIMARY KEY ("id")
+);
+
+CREATE UNIQUE INDEX "recovery_records_originalAuditId_key"
+  ON "recovery_records"("originalAuditId");
+CREATE UNIQUE INDEX "recovery_records_reversalAuditId_key"
+  ON "recovery_records"("reversalAuditId");
+CREATE INDEX "recovery_records_createdAt_idx"
+  ON "recovery_records"("createdAt");
+CREATE INDEX "recovery_records_module_createdAt_idx"
+  ON "recovery_records"("module", "createdAt");
+CREATE INDEX "recovery_records_entityType_entityId_idx"
+  ON "recovery_records"("entityType", "entityId");
+CREATE INDEX "recovery_records_requestedById_createdAt_idx"
+  ON "recovery_records"("requestedById", "createdAt");
