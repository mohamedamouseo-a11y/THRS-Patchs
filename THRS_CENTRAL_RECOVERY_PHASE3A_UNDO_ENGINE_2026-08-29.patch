diff --git a/backend/src/services/recovery.service.js b/backend/src/services/recovery.service.js
new file mode 100644
--- /dev/null
+++ b/backend/src/services/recovery.service.js
@@ -0,0 +1,235 @@
+'use strict';
+
+const prisma = require('../config/database');
+const {
+  actorSnapshot,
+  clientIp,
+  recordAuditEvent,
+  sanitizeForAudit,
+} = require('./audit.service');
+
+const SUPPORTED_ACTIONS = ['SOFT_DELETE', 'CONFIRM_DELETE'];
+
+function httpError(statusCode, message, code) {
+  const error = new Error(message);
+  error.statusCode = statusCode;
+  error.code = code || null;
+  return error;
+}
+
+function cleanNote(value) {
+  const text = String(value || '').trim();
+  return text ? text.slice(0, 1000) : null;
+}
+
+function deletionRecordIdFromEvent(event) {
+  return event?.metadata?.deletionRecordId
+    || event?.afterState?.deletionRecordId
+    || event?.beforeState?.deletionRecordId
+    || null;
+}
+
+function key(entityType, entityId) {
+  return `${String(entityType || '')}:${String(entityId || '')}`;
+}
+
+async function getRecoveryStatus(auditId) {
+  const event = await prisma.auditLog.findUnique({ where: { id: String(auditId) } });
+  if (!event) throw httpError(404, 'Audit event not found', 'AUDIT_EVENT_NOT_FOUND');
+
+  const recovery = await prisma.recoveryRecord.findUnique({
+    where: { originalAuditId: event.id },
+  });
+
+  const supported = Boolean(event.reversible)
+    && event.outcome === 'SUCCESS'
+    && SUPPORTED_ACTIONS.includes(event.action);
+
+  let active = false;
+  const deletionRecordId = deletionRecordIdFromEvent(event);
+  if (supported && deletionRecordId) {
+    const deletion = await prisma.deletionRecord.findUnique({
+      where: { id: String(deletionRecordId) },
+      select: { isActive: true, status: true },
+    });
+    active = Boolean(deletion?.isActive);
+  }
+
+  return {
+    event,
+    recovery,
+    supported,
+    available: supported && !recovery && active,
+    reason: !supported
+      ? 'NOT_SUPPORTED'
+      : recovery
+        ? 'ALREADY_UNDONE'
+        : active
+          ? null
+          : 'SOURCE_ALREADY_RESTORED_OR_INACTIVE',
+  };
+}
+
+async function listRecoverableEvents(query = {}) {
+  const page = Math.max(1, Number.parseInt(query.page, 10) || 1);
+  const pageSize = Math.min(100, Math.max(10, Number.parseInt(query.pageSize, 10) || 25));
+  const where = {
+    reversible: true,
+    outcome: 'SUCCESS',
+    action: { in: SUPPORTED_ACTIONS },
+  };
+
+  if (query.module) where.module = String(query.module).trim().toUpperCase();
+
+  const [total, events] = await Promise.all([
+    prisma.auditLog.count({ where }),
+    prisma.auditLog.findMany({
+      where,
+      orderBy: { createdAt: 'desc' },
+      skip: (page - 1) * pageSize,
+      take: pageSize,
+    }),
+  ]);
+
+  const ids = events.map((event) => event.id);
+  const recoveries = ids.length
+    ? await prisma.recoveryRecord.findMany({ where: { originalAuditId: { in: ids } } })
+    : [];
+  const recoveryByAudit = new Map(recoveries.map((row) => [row.originalAuditId, row]));
+
+  const entityPairs = events
+    .filter((event) => event.entity && event.entityId)
+    .map((event) => ({ entityType: event.entity, entityId: String(event.entityId), isActive: true }));
+  const activeDeletions = entityPairs.length
+    ? await prisma.deletionRecord.findMany({ where: { OR: entityPairs }, select: { entityType: true, entityId: true } })
+    : [];
+  const activeKeys = new Set(activeDeletions.map((row) => key(row.entityType, row.entityId)));
+
+  return {
+    events: events.map((event) => {
+      const recovery = recoveryByAudit.get(event.id) || null;
+      const active = activeKeys.has(key(event.entity, event.entityId));
+      return {
+        ...event,
+        recovery,
+        recoveryAvailable: !recovery && active,
+      };
+    }),
+    pagination: {
+      page,
+      pageSize,
+      total,
+      pages: Math.max(1, Math.ceil(total / pageSize)),
+    },
+  };
+}
+
+async function getRecoverySummary() {
+  const [eligibleEvents, completedRecoveries, latestRecovery] = await Promise.all([
+    prisma.auditLog.count({
+      where: { reversible: true, outcome: 'SUCCESS', action: { in: SUPPORTED_ACTIONS } },
+    }),
+    prisma.recoveryRecord.count({ where: { status: 'COMPLETED' } }),
+    prisma.recoveryRecord.findFirst({ orderBy: { createdAt: 'desc' }, select: { createdAt: true } }),
+  ]);
+
+  return {
+    eligibleEvents,
+    completedRecoveries,
+    remaining: Math.max(0, eligibleEvents - completedRecoveries),
+    latestRecoveryAt: latestRecovery?.createdAt || null,
+    supportedActions: SUPPORTED_ACTIONS,
+  };
+}
+
+async function undoAuditEvent(req, auditId, note) {
+  const originalAuditId = String(auditId || '').trim();
+  if (!originalAuditId) throw httpError(400, 'Audit event ID is required', 'AUDIT_EVENT_ID_REQUIRED');
+
+  const actor = actorSnapshot(req);
+  const reviewNote = cleanNote(note);
+  const now = new Date();
+
+  return prisma.$transaction(async (tx) => {
+    const event = await tx.auditLog.findUnique({ where: { id: originalAuditId } });
+    if (!event) throw httpError(404, 'Audit event not found', 'AUDIT_EVENT_NOT_FOUND');
+    if (!event.reversible || event.outcome !== 'SUCCESS' || !SUPPORTED_ACTIONS.includes(event.action)) {
+      throw httpError(409, 'This audit event is not recoverable in Phase 3A.', 'RECOVERY_NOT_SUPPORTED');
+    }
+
+    const existing = await tx.recoveryRecord.findUnique({ where: { originalAuditId: event.id } });
+    if (existing) throw httpError(409, 'This audit event has already been undone.', 'RECOVERY_ALREADY_COMPLETED');
+
+    const deletionRecordId = deletionRecordIdFromEvent(event);
+    if (!deletionRecordId) {
+      throw httpError(409, 'The deletion governance record cannot be resolved.', 'DELETION_RECORD_NOT_RESOLVED');
+    }
+
+    const deletion = await tx.deletionRecord.findUnique({ where: { id: String(deletionRecordId) } });
+    if (!deletion) throw httpError(404, 'Deletion record not found', 'DELETION_RECORD_NOT_FOUND');
+    if (!deletion.isActive) {
+      throw httpError(409, 'The source record is already restored or inactive.', 'SOURCE_ALREADY_RESTORED');
+    }
+
+    const restored = await tx.deletionRecord.update({
+      where: { id: deletion.id },
+      data: {
+        status: 'RESTORED',
+        isActive: false,
+        reviewedById: actor.userId || null,
+        reviewedByName: actor.actorName || null,
+        reviewedByEmail: actor.actorEmail || null,
+        reviewedByRole: actor.actorRole || null,
+        reviewedAt: now,
+        restoredAt: now,
+        reviewNote: reviewNote || `Undo of audit event ${event.id}`,
+      },
+    });
+
+    const reversalEvent = await recordAuditEvent({
+      ...actor,
+      action: 'UNDO',
+      module: event.module,
+      entity: event.entity,
+      entityId: event.entityId,
+      summary: `Undo ${event.action} for ${event.entity || 'record'}`,
+      beforeState: {
+        originalAuditId: event.id,
+        deletionRecordId: deletion.id,
+        deletionStatus: deletion.status,
+        deletionActive: deletion.isActive,
+      },
+      afterState: {
+        deletionRecordId: restored.id,
+        deletionStatus: restored.status,
+        deletionActive: restored.isActive,
+      },
+      metadata: {
+        reversalOfAuditId: event.id,
+        originalAction: event.action,
+        note: reviewNote,
+      },
+      requestId: req.auditRequestId || null,
+      method: req.method || 'POST',
+      route: req.originalUrl || null,
+      outcome: 'SUCCESS',
+      statusCode: 200,
+      source: actor.source || 'WEB',
+      reversible: false,
+      ipAddress: clientIp(req),
+      userAgent: req.get?.('user-agent') || null,
+    }, tx);
+
+    if (!reversalEvent) {
+      throw httpError(500, 'Unable to write reversal audit event.', 'REVERSAL_AUDIT_WRITE_FAILED');
+    }
+
+    const recovery = await tx.recoveryRecord.create({
+      data: {
+        originalAuditId: event.id,
+        reversalAuditId: reversalEvent.id,
+        module: event.module,
+        entityType: event.entity || null,
+        entityId: event.entityId || null,
+        originalAction: event.action,
+        status: 'COMPLETED',
+        note: reviewNote,
+        requestedById: actor.userId || null,
+        requestedByName: actor.actorName || null,
+        requestedByEmail: actor.actorEmail || null,
+        requestedByRole: actor.actorRole || null,
+        metadata: sanitizeForAudit({
+          deletionRecordId: restored.id,
+          requestId: req.auditRequestId || null,
+        }),
+      },
+    });
+
+    return { recovery, reversalEvent, restored };
+  });
+}
+
+module.exports = {
+  SUPPORTED_ACTIONS,
+  getRecoveryStatus,
+  listRecoverableEvents,
+  getRecoverySummary,
+  undoAuditEvent,
+};
diff --git a/backend/src/controllers/recovery.controller.js b/backend/src/controllers/recovery.controller.js
new file mode 100644
