+/* THRS Overtime V1.1 Final Polish
+   Visual-only overrides layered after thrs-overtime-v1-premium.css.
+   No workflow, API, permissions, calculations, or data behavior changes. */
+
+.thrs-overtime-v1 {
+  --ot-v11-gap: 14px;
+}
+
+.thrs-overtime-v1 .thrs-ot-hero {
+  min-height: 0;
+  padding: 16px 20px !important;
+  margin-bottom: 14px;
+}
+
+.thrs-overtime-v1 .thrs-ot-hero-copy {
+  gap: 12px;
+}
+
+.thrs-overtime-v1 .thrs-ot-hero-icon {
+  width: 44px;
+  height: 44px;
+  flex: 0 0 44px;
+}
+
+.thrs-overtime-v1 .thrs-ot-hero .page-title {
+  font-size: clamp(24px, 2vw, 30px);
+  line-height: 1.08;
+  margin: 2px 0 4px;
+}
+
+.thrs-overtime-v1 .thrs-ot-hero p {
+  margin: 0;
+  line-height: 1.35;
+}
+
+.thrs-overtime-v1 .thrs-ot-request-btn {
+  min-height: 38px;
+  padding-inline: 16px !important;
+}
+
+.thrs-overtime-v1 .thrs-ot-kpis {
+  gap: 12px;
+  margin-bottom: 14px;
+}
+
+.thrs-overtime-v1 .thrs-ot-kpi {
+  min-height: 108px;
+}
+
+.thrs-overtime-v1 .thrs-ot-kpi > div {
+  padding: 16px 18px !important;
+}
+
+.thrs-overtime-v1 .thrs-ot-kpi strong {
+  font-size: clamp(24px, 2vw, 30px);
+  line-height: 1;
+  margin-block: 8px 6px;
+}
+
+.thrs-overtime-v1 .thrs-ot-tabs {
+  display: inline-flex;
+  width: auto;
+  max-width: 100%;
+  gap: 4px;
+  padding: 4px;
+  margin: 0 0 14px;
+  border: 1px solid #dfe6ef;
+  border-radius: 12px;
+  background: #f7f9fc;
+  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
+}
+
+.thrs-overtime-v1 .thrs-ot-tabs button {
+  flex: 0 0 auto;
+  min-width: 180px;
+  min-height: 36px;
+  padding: 8px 16px;
+  border-radius: 9px;
+  white-space: nowrap;
+}
+
+.thrs-overtime-v1 .thrs-ot-tabs button span {
+  margin-inline-start: 6px;
+}
+
+.thrs-overtime-v1 .thrs-ot-filters {
+  grid-template-columns: minmax(250px, 1.6fr) minmax(150px, .65fr) minmax(170px, .7fr) auto;
+  gap: 10px;
+  padding: 12px 14px;
+  margin-bottom: 14px;
+}
+
+.thrs-overtime-v1 .thrs-ot-filters label {
+  gap: 5px;
+}
+
+.thrs-overtime-v1 .thrs-ot-filters input,
+.thrs-overtime-v1 .thrs-ot-filters select {
+  min-height: 38px;
+  height: 38px;
+}
+
+.thrs-overtime-v1 .thrs-ot-filters > button {
+  min-height: 38px;
+  align-self: end;
+  padding-inline: 13px;
+}
+
+.thrs-overtime-v1 .thrs-ot-table-card {
+  margin-bottom: 14px;
+}
+
+.thrs-overtime-v1 .thrs-ot-table-card > div {
+  padding: 0 !important;
+}
+
+.thrs-overtime-v1 .thrs-ot-section-head {
+  padding: 14px 16px;
+}
+
+.thrs-overtime-v1 .thrs-ot-section-head h2 {
+  margin: 2px 0;
+  font-size: 17px;
+}
+
+.thrs-overtime-v1 .thrs-ot-section-head p {
+  margin: 0;
+}
+
+.thrs-overtime-v1 .thrs-ot-section-head select {
+  min-height: 36px;
+}
+
+.thrs-overtime-v1 .thrs-ot-table-wrap {
+  max-height: min(68vh, 720px);
+  overflow: auto;
+  overscroll-behavior: contain;
+  scrollbar-gutter: stable;
+}
+
+.thrs-overtime-v1 .thrs-ot-table {
+  width: 100%;
+  table-layout: fixed;
+}
+
+.thrs-overtime-v1 .thrs-ot-table thead th {
+  position: sticky;
+  top: 0;
+  z-index: 4;
+  background: #f8fafc;
+  box-shadow: inset 0 -1px 0 #dde5ee;
+}
+
+.thrs-overtime-v1 .thrs-ot-table th,
+.thrs-overtime-v1 .thrs-ot-table td {
+  padding: 11px 12px;
+  vertical-align: middle;
+}
+
+.thrs-overtime-v1 .thrs-ot-table th {
+  font-size: 11px;
+  letter-spacing: .035em;
+}
+
+.thrs-overtime-v1 .thrs-ot-table td {
+  font-size: 13px;
+  line-height: 1.4;
+}
+
+.thrs-overtime-v1 .thrs-ot-col-employee {
+  width: 18%;
+}
+
+.thrs-overtime-v1 .thrs-ot-col-date {
+  width: 11%;
+}
+
+.thrs-overtime-v1 .thrs-ot-col-hours {
+  width: 9%;
+}
+
+.thrs-overtime-v1 .thrs-ot-col-reason {
+  width: 38%;
+}
+
+.thrs-overtime-v1 .thrs-ot-col-status {
+  width: 12%;
+}
+
+.thrs-overtime-v1 .thrs-ot-col-actions {
+  width: 12%;
+}
+
+.thrs-overtime-v1 .thrs-ot-employee {
+  gap: 8px;
+}
+
+.thrs-overtime-v1 .thrs-ot-employee > span {
+  width: 28px;
+  height: 28px;
+  flex: 0 0 28px;
+  font-size: 10px;
+}
+
+.thrs-overtime-v1 .thrs-ot-employee strong,
+.thrs-overtime-v1 .thrs-ot-date,
+.thrs-overtime-v1 .thrs-ot-hours {
+  font-size: 13px;
+}
+
+.thrs-overtime-v1 .thrs-ot-reason,
+.thrs-overtime-v1 .thrs-ot-reason .rich-text-view,
+.thrs-overtime-v1 .thrs-ot-reason p {
+  font-size: 13.5px;
+  line-height: 1.45;
+}
+
+.thrs-overtime-v1 .thrs-ot-reason {
+  display: -webkit-box;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 2;
+  overflow: hidden;
+  max-width: none;
+}
+
+.thrs-overtime-v1 .thrs-ot-reason .rich-text-view,
+.thrs-overtime-v1 .thrs-ot-reason p {
+  margin: 0;
+}
+
+.thrs-overtime-v1 .thrs-ot-status {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 24px;
+  padding: 4px 9px;
+  font-size: 10.5px;
+  font-weight: 800;
+  letter-spacing: .02em;
+}
+
+.thrs-overtime-v1 .thrs-ot-actions {
+  gap: 5px;
+  flex-wrap: nowrap;
+}
+
+.thrs-overtime-v1 .thrs-ot-actions .thrs-btn {
+  min-height: 30px;
+  padding: 5px 8px;
+  font-size: 11px;
+}
+
+.thrs-overtime-v1 .thrs-ot-pagination {
+  padding: 10px 14px 12px;
+}
+
+.thrs-overtime-v1 .thrs-ot-pagination button {
+  min-height: 32px;
+  padding: 5px 10px;
+}
+
+.thrs-overtime-v1 .thrs-ot-summary-card {
+  margin-bottom: 14px;
+}
+
+.thrs-overtime-v1 > .thrs-card:last-of-type {
+  margin-top: 14px;
+}
+
+.thrs-overtime-v1 > .thrs-card:last-of-type > div {
+  padding: 14px 16px !important;
+}
+
+.thrs-overtime-v1 > .thrs-card:last-of-type h2,
+.thrs-overtime-v1 > .thrs-card:last-of-type h3 {
+  margin-block: 0 6px;
+}
+
+@media (max-width: 1100px) {
+  .thrs-overtime-v1 .thrs-ot-filters {
+    grid-template-columns: 1fr 1fr;
+  }
+
+  .thrs-overtime-v1 .thrs-ot-filters > button {
+    width: 100%;
+  }
+
+  .thrs-overtime-v1 .thrs-ot-col-reason {
+    width: 32%;
+  }
+
+  .thrs-overtime-v1 .thrs-ot-col-employee {
+    width: 20%;
+  }
+
+  .thrs-overtime-v1 .thrs-ot-col-actions {
+    width: 15%;
+  }
+}
+
+@media (max-width: 760px) {
+  .thrs-overtime-v1 .thrs-ot-hero {
+    padding: 14px 16px !important;
+  }
+
+  .thrs-overtime-v1 .thrs-ot-tabs {
+    display: flex;
+    width: 100%;
+  }
+
+  .thrs-overtime-v1 .thrs-ot-tabs button {
+    flex: 1 1 0;
+    min-width: 0;
+  }
+
+  .thrs-overtime-v1 .thrs-ot-filters {
+    grid-template-columns: 1fr;
+  }
+
+  .thrs-overtime-v1 .thrs-ot-table-wrap {
+    max-height: none;
+  }
+
+  .thrs-overtime-v1 .thrs-ot-table {
+    table-layout: auto;
+  }
+}
