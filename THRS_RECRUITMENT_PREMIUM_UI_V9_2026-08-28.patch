+/* THRS Recruitment Premium UI V9
+   UI-only visual layer for Recruitment.jsx.
+   No API, filtering, status, pagination, modal, or business-logic changes.
+*/
+
+.thrs-page-recruitment.thrs-recruitment-ux-v5 {
+  --rec-v9-navy: #0b2b4d;
+  --rec-v9-navy-2: #123f6c;
+  --rec-v9-gold: #c99b36;
+  --rec-v9-text: #102a43;
+  --rec-v9-muted: #6b7f95;
+  --rec-v9-border: #e5edf5;
+  --rec-v9-surface: #ffffff;
+  --rec-v9-soft: #f7faff;
+  --rec-v9-shadow: 0 12px 34px rgba(15, 39, 68, 0.08);
+  --rec-v9-shadow-sm: 0 5px 18px rgba(15, 39, 68, 0.06);
+  --rec-v9-radius-xl: 24px;
+  --rec-v9-radius-lg: 18px;
+  --rec-v9-radius-md: 14px;
+
+  max-width: 1440px;
+  margin: 0 auto;
+  padding: 26px 30px 52px;
+  color: var(--rec-v9-text);
+}
+
+/* ---------- Hero ---------- */
+.thrs-page-recruitment.thrs-recruitment-ux-v5 .thrs-rec-v7-hero {
+  position: relative;
+  min-height: 118px;
+  margin: 0 0 18px;
+  padding: 24px 28px;
+  border: 1px solid rgba(207, 221, 235, 0.92);
+  border-radius: var(--rec-v9-radius-xl);
+  background:
+    radial-gradient(circle at 90% 10%, rgba(201, 155, 54, 0.10), transparent 26%),
+    radial-gradient(circle at 8% 90%, rgba(37, 99, 235, 0.08), transparent 30%),
+    linear-gradient(135deg, #ffffff 0%, #fbfdff 100%);
+  box-shadow: var(--rec-v9-shadow);
+  overflow: hidden;
+}
+
+.thrs-page-recruitment.thrs-recruitment-ux-v5 .thrs-rec-v7-hero::after {
+  content: "";
+  position: absolute;
+  inset-inline-end: 20px;
+  bottom: 0;
+  width: 84px;
+  height: 3px;
+  border-radius: 999px 999px 0 0;
+  background: linear-gradient(90deg, var(--rec-v9-gold), #f0cf73);
+}
+
+.thrs-page-recruitment.thrs-recruitment-ux-v5 .thrs-rec-v7-hero-copy {
+  display: flex;
+  align-items: center;
+  gap: 18px;
+  min-width: 0;
+}
+
+.thrs-page-recruitment.thrs-recruitment-ux-v5 .thrs-rec-v7-hero-icon {
+  width: 54px;
+  height: 54px;
+  flex: 0 0 54px;
+  display: grid;
+  place-items: center;
+  color: #b98215;
+  border: 1px solid #f1dfb5;
+  border-radius: 17px;
+  background: linear-gradient(145deg, #fffdf7, #fff9ea);
+  box-shadow: 0 8px 20px rgba(174, 126, 25, 0.10);
+}
+
+.thrs-page-recruitment.thrs-recruitment-ux-v5 .thrs-rec-v7-hero-text .page-title {
+  margin: 0;
+  color: var(--rec-v9-text);
+  font-size: clamp(26px, 2.2vw, 36px);
+  line-height: 1.1;
+  letter-spacing: -0.03em;
+  font-weight: 800;
+}
+
+.thrs-page-recruitment.thrs-recruitment-ux-v5 .thrs-rec-v7-hero-text p {
+  margin: 8px 0 0;
+  color: var(--rec-v9-muted);
+  font-size: 14px;
+  font-weight: 550;
+}
+
+.thrs-page-recruitment.thrs-recruitment-ux-v5 .thrs-rec-v7-primary-action {
+  min-height: 44px;
+  padding: 0 18px;
+  border: 1px solid #0a2745;
+  border-radius: 13px;
+  background: linear-gradient(180deg, #123d68, #092947);
+  color: #fff;
+  font-size: 13px;
+  font-weight: 750;
+  box-shadow: 0 9px 20px rgba(9, 41, 71, 0.20);
+  transition: transform 160ms ease, box-shadow 160ms ease, filter 160ms ease;
+}
