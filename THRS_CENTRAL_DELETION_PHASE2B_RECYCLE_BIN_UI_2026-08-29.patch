diff --git a/frontend/src/pages/DeletionCenter.jsx b/frontend/src/pages/DeletionCenter.jsx
new file mode 100644
--- /dev/null
+++ b/frontend/src/pages/DeletionCenter.jsx
@@ -0,0 +1,499 @@
+import React, { useCallback, useEffect, useMemo, useState } from 'react';
+import api from '../services/api';
+import '../styles/thrs-deletion-center.css';
+
+const EMPTY_FILTERS = {
+  search: '',
+  module: '',
+  entityType: '',
+  status: '',
+  active: '',
+  from: '',
+  to: '',
+};
+
+const STATUS_LABELS = {
+  PENDING_REVIEW: 'Pending review',
+  CONFIRMED: 'Confirmed soft delete',
+  RESTORED: 'Restored',
+};
+
+function prettyToken(value) {
+  return String(value || '—')
+    .replace(/_/g, ' ')
+    .toLowerCase()
+    .replace(/\b\w/g, (char) => char.toUpperCase());
+}
+
+function formatDate(value) {
+  if (!value) return '—';
+  const date = new Date(value);
+  if (Number.isNaN(date.getTime())) return '—';
+  return date.toLocaleString(undefined, {
+    year: 'numeric',
+    month: 'short',
+    day: '2-digit',
+    hour: '2-digit',
+    minute: '2-digit',
+  });
+}
+
+function JsonBlock({ title, value }) {
+  if (value === null || value === undefined) return null;
+  return (
+    <section className="thrs-delete-json-card">
+      <div className="thrs-delete-json-title">{title}</div>
+      <pre>{JSON.stringify(value, null, 2)}</pre>
+    </section>
+  );
+}
+
+const DeletionCenter = () => {
+  const [records, setRecords] = useState([]);
+  const [summary, setSummary] = useState({
+    pending: 0,
+    confirmed: 0,
+    restored: 0,
+    active: 0,
+    total: 0,
+  });
+  const [filters, setFilters] = useState(EMPTY_FILTERS);
+  const [appliedFilters, setAppliedFilters] = useState(EMPTY_FILTERS);
+  const [pagination, setPagination] = useState({ page: 1, pageSize: 25, total: 0, pages: 1 });
+  const [selected, setSelected] = useState(null);
+  const [review, setReview] = useState(null);
+  const [reviewNote, setReviewNote] = useState('');
+  const [loading, setLoading] = useState(true);
+  const [submitting, setSubmitting] = useState(false);
+  const [error, setError] = useState('');
+  const [notice, setNotice] = useState('');
+
+  const modules = useMemo(
+    () => Array.from(new Set(records.map((record) => record.module).filter(Boolean))).sort(),
+    [records]
+  );
+
+  const entityTypes = useMemo(
+    () => Array.from(new Set(records.map((record) => record.entityType).filter(Boolean))).sort(),
+    [records]
+  );
+
+  const loadSummary = useCallback(async () => {
+    try {
+      const response = await api.get('/deletions/summary');
+      setSummary(response?.data?.data || {});
+    } catch (requestError) {
+      console.error('Deletion summary failed:', requestError);
+    }
+  }, []);
+
+  const loadRecords = useCallback(async (page = 1, pageSize = pagination.pageSize) => {
+    setLoading(true);
+    setError('');
+    try {
+      const params = {
+        page,
+        pageSize,
+        ...Object.fromEntries(
+          Object.entries(appliedFilters).filter(([, value]) => String(value || '').trim())
+        ),
+      };
+      const response = await api.get('/deletions/records', { params });
+      const payload = response?.data?.data || {};
+      setRecords(payload.records || []);
+      setPagination(payload.pagination || { page, pageSize, total: 0, pages: 1 });
+    } catch (requestError) {
+      setError(requestError?.response?.data?.message || requestError?.message || 'Failed to load deletion records.');
+    } finally {
+      setLoading(false);
+    }
+  }, [appliedFilters, pagination.pageSize]);
+
+  useEffect(() => {
+    loadSummary();
+  }, [loadSummary]);
+
+  useEffect(() => {
+    loadRecords(1, pagination.pageSize);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [appliedFilters]);
+
+  const applyFilters = (event) => {
+    event.preventDefault();
+    setAppliedFilters({ ...filters });
+  };
+
+  const clearFilters = () => {
+    setFilters(EMPTY_FILTERS);
+    setAppliedFilters(EMPTY_FILTERS);
+  };
+
+  const changePageSize = (event) => {
+    const next = Number(event.target.value);
+    setPagination((current) => ({ ...current, pageSize: next }));
+    loadRecords(1, next);
+  };
+
+  const openDetails = async (record) => {
+    setSelected(record);
+    try {
+      const response = await api.get(`/deletions/records/${record.id}`);
+      if (response?.data?.data) setSelected(response.data.data);
+    } catch (requestError) {
+      console.error('Deletion detail failed:', requestError);
+    }
+  };
+
+  const openReview = (record, mode) => {
+    setReview({ record, mode });
+    setReviewNote('');
+    setNotice('');
+  };
+
+  const submitReview = async () => {
+    if (!review?.record?.id || submitting) return;
+    setSubmitting(true);
+    setError('');
+    try {
+      const endpoint = review.mode === 'restore'
+        ? `/deletions/records/${review.record.id}/restore`
+        : `/deletions/records/${review.record.id}/confirm`;
+      const response = await api.post(endpoint, { note: reviewNote.trim() || undefined });
+      setNotice(
+        response?.data?.message
+        || (review.mode === 'restore' ? 'Record restored successfully.' : 'Soft deletion confirmed.')
+      );
+      setReview(null);
+      setReviewNote('');
+      setSelected(null);
+      await Promise.all([loadSummary(), loadRecords(pagination.page, pagination.pageSize)]);
+    } catch (requestError) {
+      setError(requestError?.response?.data?.message || requestError?.message || 'Deletion review failed.');
+    } finally {
+      setSubmitting(false);
+    }
+  };
+
+  return (
+    <div className="thrs-delete-center">
+      <header className="thrs-delete-hero">
+        <div>
+          <span className="thrs-delete-eyebrow">SYSTEM GOVERNANCE · PHASE 2</span>
+          <h1>Central Deletion Center</h1>
+          <p>Recycle Bin, recovery controls, and Super Admin review for soft-deleted THRS data.</p>
+        </div>
+        <div className="thrs-delete-phase-badge">
+          <span className="thrs-delete-live-dot" />
+          Soft delete governance active
+        </div>
+      </header>
+
+      <section className="thrs-delete-kpis" aria-label="Deletion governance summary">
+        <article>
+          <span>Pending review</span>
+          <strong>{summary.pending || 0}</strong>
+          <small>Waiting for Super Admin decision</small>
+        </article>
+        <article>
+          <span>Active hidden</span>
+          <strong>{summary.active || 0}</strong>
+          <small>Hidden from normal business views</small>
+        </article>
+        <article>
+          <span>Confirmed</span>
+          <strong>{summary.confirmed || 0}</strong>
+          <small>Soft deletion confirmed, no purge</small>
+        </article>
+        <article>
+          <span>Restored</span>
+          <strong>{summary.restored || 0}</strong>
+          <small>Returned to normal business views</small>
+        </article>
+      </section>
+
+      <section className="thrs-delete-governance-note">
+        <div>
+          <strong>No physical purge in Phase 2.</strong>
+          <span>Confirm keeps the source record preserved. Restore exposes the same original record again.</span>
+        </div>
+        <span className="thrs-delete-admin-pill">PRIMARY SUPER ADMIN</span>
+      </section>
+
+      {notice && <div className="thrs-delete-notice">{notice}</div>}
+      {error && <div className="thrs-delete-error">{error}</div>}
+
+      <form className="thrs-delete-filters" onSubmit={applyFilters}>
+        <label className="thrs-delete-search">
+          <span>Search recycle bin</span>
+          <input
+            value={filters.search}
+            onChange={(event) => setFilters((current) => ({ ...current, search: event.target.value }))}
+            placeholder="Record, requester, reason, ID..."
+          />
+        </label>
+        <label>
+          <span>Module</span>
+          <input
+            list="thrs-delete-modules"
+            value={filters.module}
+            onChange={(event) => setFilters((current) => ({ ...current, module: event.target.value.toUpperCase() }))}
+            placeholder="All modules"
+          />
+          <datalist id="thrs-delete-modules">
+            {modules.map((moduleName) => <option key={moduleName} value={moduleName} />)}
+          </datalist>
+        </label>
+        <label>
+          <span>Entity</span>
+          <input
+            list="thrs-delete-entities"
+            value={filters.entityType}
+            onChange={(event) => setFilters((current) => ({ ...current, entityType: event.target.value.toUpperCase() }))}
+            placeholder="All entities"
+          />
+          <datalist id="thrs-delete-entities">
+            {entityTypes.map((entityType) => <option key={entityType} value={entityType} />)}
+          </datalist>
+        </label>
+        <label>
+          <span>Status</span>
+          <select
+            value={filters.status}
+            onChange={(event) => setFilters((current) => ({ ...current, status: event.target.value }))}
+          >
+            <option value="">All statuses</option>
+            <option value="PENDING_REVIEW">Pending review</option>
+            <option value="CONFIRMED">Confirmed</option>
+            <option value="RESTORED">Restored</option>
+          </select>
+        </label>
+        <label>
+          <span>Visibility</span>
+          <select
+            value={filters.active}
+            onChange={(event) => setFilters((current) => ({ ...current, active: event.target.value }))}
+          >
+            <option value="">All records</option>
+            <option value="true">Hidden / active delete</option>
+            <option value="false">Restored / inactive</option>
+          </select>
+        </label>
+        <label>
+          <span>From</span>
+          <input type="date" value={filters.from} onChange={(event) => setFilters((current) => ({ ...current, from: event.target.value }))} />
+        </label>
+        <label>
+          <span>To</span>
+          <input type="date" value={filters.to} onChange={(event) => setFilters((current) => ({ ...current, to: event.target.value }))} />
+        </label>
+        <div className="thrs-delete-filter-actions">
+          <button type="button" onClick={clearFilters}>Clear</button>
+          <button type="submit" className="is-primary">Apply</button>
+        </div>
+      </form>
+
+      <section className="thrs-delete-ledger-card">
+        <div className="thrs-delete-ledger-head">
+          <div>
+            <span className="thrs-delete-eyebrow">RECYCLE BIN LEDGER</span>
+            <h2>Deletion Requests</h2>
+            <p>{pagination.total || 0} governed deletion records</p>
+          </div>
+          <label className="thrs-delete-page-size">
+            <span>Rows</span>
+            <select value={pagination.pageSize} onChange={changePageSize}>
+              <option value={25}>25</option>
+              <option value={50}>50</option>
+              <option value={100}>100</option>
+            </select>
+          </label>
+        </div>
+
+        <div className="thrs-delete-table-wrap">
+          <table className="thrs-delete-table">
+            <thead>
+              <tr>
+                <th>Requested</th>
+                <th>Record</th>
+                <th>Module / Type</th>
+                <th>Requested by</th>
+                <th>Reason</th>
+                <th>Status</th>
+                <th aria-label="Actions" />
+              </tr>
+            </thead>
+            <tbody>
+              {loading && (
+                <tr><td colSpan="7" className="thrs-delete-empty">Loading deletion governance ledger…</td></tr>
+              )}
+              {!loading && records.length === 0 && (
+                <tr><td colSpan="7" className="thrs-delete-empty">No deletion records match the current filters.</td></tr>
+              )}
+              {!loading && records.map((record) => (
+                <tr key={record.id}>
+                  <td>
+                    <strong>{formatDate(record.requestedAt || record.createdAt)}</strong>
+                    <small>{String(record.id || '').slice(0, 8)}</small>
+                  </td>
+                  <td>
+                    <strong>{record.entityLabel || `${prettyToken(record.entityType)} record`}</strong>
+                    <small>{String(record.entityId || '').slice(0, 16)}</small>
+                  </td>
+                  <td>
+                    <strong>{prettyToken(record.module)}</strong>
+                    <small>{prettyToken(record.entityType)}</small>
+                  </td>
+                  <td>
+                    <strong>{record.requestedByName || record.requestedByEmail || 'System actor'}</strong>
+                    <small>{prettyToken(record.requestedByRole)}</small>
+                  </td>
+                  <td className="thrs-delete-reason">
+                    <strong>{record.reason || 'No reason supplied'}</strong>
+                    <small>{record.reviewNote ? `Review: ${record.reviewNote}` : 'No review note yet'}</small>
+                  </td>
+                  <td>
+                    <span className={`thrs-delete-status is-${String(record.status || '').toLowerCase()}`}>
+                      {STATUS_LABELS[record.status] || prettyToken(record.status)}
+                    </span>
+                    <small>{record.isActive ? 'Hidden from normal views' : 'Visible / restored'}</small>
+                  </td>
+                  <td>
+                    <div className="thrs-delete-row-actions">
+                      <button type="button" onClick={() => openDetails(record)}>Inspect</button>
+                      {record.status === 'PENDING_REVIEW' && record.isActive && (
+                        <button type="button" className="is-confirm" onClick={() => openReview(record, 'confirm')}>
+                          Confirm
+                        </button>
+                      )}
+                      {record.isActive && (
+                        <button type="button" className="is-restore" onClick={() => openReview(record, 'restore')}>
+                          Restore
+                        </button>
+                      )}
+                    </div>
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+
+        <footer className="thrs-delete-pagination">
+          <span>Page {pagination.page} of {pagination.pages}</span>
+          <div>
+            <button
+              type="button"
+              disabled={pagination.page <= 1 || loading}
+              onClick={() => loadRecords(pagination.page - 1)}
+            >
+              Previous
+            </button>
+            <button
+              type="button"
+              disabled={pagination.page >= pagination.pages || loading}
+              onClick={() => loadRecords(pagination.page + 1)}
+            >
+              Next
+            </button>
+          </div>
+        </footer>
+      </section>
+
+      {selected && (
+        <div className="thrs-delete-drawer-backdrop" role="presentation" onMouseDown={() => setSelected(null)}>
+          <aside
+            className="thrs-delete-drawer"
+            role="dialog"
+            aria-modal="true"
+            aria-label="Deletion record details"
+            onMouseDown={(event) => event.stopPropagation()}
+          >
+            <div className="thrs-delete-drawer-head">
+              <div>
+                <span className="thrs-delete-eyebrow">DELETION RECORD</span>
+                <h2>{selected.entityLabel || prettyToken(selected.entityType)}</h2>
+                <p>{selected.reason || 'Governed soft deletion record'}</p>
+              </div>
+              <button type="button" onClick={() => setSelected(null)} aria-label="Close deletion details">×</button>
+            </div>
+
+            <div className="thrs-delete-detail-grid">
+              <div><span>Status</span><strong>{STATUS_LABELS[selected.status] || prettyToken(selected.status)}</strong></div>
+              <div><span>Visibility</span><strong>{selected.isActive ? 'Hidden' : 'Restored / visible'}</strong></div>
+              <div><span>Requested by</span><strong>{selected.requestedByName || selected.requestedByEmail || '—'}</strong></div>
+              <div><span>Requested</span><strong>{formatDate(selected.requestedAt)}</strong></div>
+              <div><span>Reviewed by</span><strong>{selected.reviewedByName || selected.reviewedByEmail || 'Pending'}</strong></div>
+              <div><span>Reviewed</span><strong>{formatDate(selected.reviewedAt)}</strong></div>
+              <div><span>Module</span><strong>{prettyToken(selected.module)}</strong></div>
+              <div><span>Entity</span><strong>{prettyToken(selected.entityType)} · {selected.entityId}</strong></div>
+            </div>
+
+            {selected.isActive && (
+              <div className="thrs-delete-drawer-actions">
+                {selected.status === 'PENDING_REVIEW' && (
+                  <button type="button" className="is-confirm" onClick={() => openReview(selected, 'confirm')}>
+                    Confirm soft delete
+                  </button>
+                )}
+                <button type="button" className="is-restore" onClick={() => openReview(selected, 'restore')}>
+                  Restore record
+                </button>
+              </div>
+            )}
+
+            <JsonBlock title="Preserved snapshot" value={selected.snapshot} />
+            <JsonBlock title="Governance metadata" value={selected.metadata} />
+          </aside>
+        </div>
+      )}
+
+      {review && (
+        <div className="thrs-delete-review-backdrop" role="presentation" onMouseDown={() => !submitting && setReview(null)}>
+          <section
+            className="thrs-delete-review-modal"
+            role="dialog"
+            aria-modal="true"
+            aria-label={review.mode === 'restore' ? 'Restore record' : 'Confirm soft deletion'}
+            onMouseDown={(event) => event.stopPropagation()}
+          >
+            <span className="thrs-delete-eyebrow">
+              {review.mode === 'restore' ? 'RECOVERY ACTION' : 'SUPER ADMIN REVIEW'}
+            </span>
+            <h2>{review.mode === 'restore' ? 'Restore this record?' : 'Confirm this soft deletion?'}</h2>
+            <p>
+              {review.mode === 'restore'
+                ? 'The original business record will become visible again. Nothing will be recreated or duplicated.'
+                : 'The record will remain preserved and hidden. Phase 2 never performs a permanent purge.'}
+            </p>
+            <div className="thrs-delete-review-target">
+              <strong>{review.record.entityLabel || prettyToken(review.record.entityType)}</strong>
+              <span>{prettyToken(review.record.module)} · {prettyToken(review.record.entityType)}</span>
+            </div>
+            <label>
+              <span>Review note</span>
+              <textarea
+                value={reviewNote}
+                onChange={(event) => setReviewNote(event.target.value)}
+                maxLength={1000}
+                placeholder="Optional governance note..."
+              />
+            </label>
+            <div className="thrs-delete-review-actions">
+              <button type="button" disabled={submitting} onClick={() => setReview(null)}>Cancel</button>
+              <button
+                type="button"
+                disabled={submitting}
+                className={review.mode === 'restore' ? 'is-restore' : 'is-confirm'}
+                onClick={submitReview}
+              >
+                {submitting ? 'Processing…' : review.mode === 'restore' ? 'Restore original record' : 'Confirm soft delete'}
+              </button>
+            </div>
+          </section>
+        </div>
+      )}
+    </div>
+  );
+};
+
+export default DeletionCenter;
diff --git a/frontend/src/styles/thrs-deletion-center.css b/frontend/src/styles/thrs-deletion-center.css
new file mode 100644
--- /dev/null
