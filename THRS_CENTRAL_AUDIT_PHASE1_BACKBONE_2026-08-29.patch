+
+CREATE INDEX IF NOT EXISTS "audit_logs_module_action_createdAt_idx"
+  ON "audit_logs"("module", "action", "createdAt");
+
+CREATE INDEX IF NOT EXISTS "audit_logs_entity_entityId_idx"
+  ON "audit_logs"("entity", "entityId");
+
+CREATE INDEX IF NOT EXISTS "audit_logs_requestId_idx"
+  ON "audit_logs"("requestId");
diff --git a/backend/src/services/audit.service.js b/backend/src/services/audit.service.js
new file mode 100644
--- /dev/null
+++ b/backend/src/services/audit.service.js
@@ -0,0 +1,146 @@
+'use strict';
+
+const prisma = require('../config/database');
+
+const SENSITIVE_KEY = /(password|passcode|token|secret|authorization|cookie|session|signature|api[-_]?key|clientSecret|refreshToken|resetToken)/i;
+const MAX_DEPTH = 5;
+const MAX_ARRAY = 50;
+const MAX_OBJECT_KEYS = 100;
+const MAX_STRING = 2000;
+
+function sanitizeForAudit(value, depth = 0) {
+  if (value === null || value === undefined) return value;
+  if (depth > MAX_DEPTH) return '[TRUNCATED_DEPTH]';
+
+  if (typeof value === 'string') {
+    return value.length > MAX_STRING ? `${value.slice(0, MAX_STRING)}…[TRUNCATED]` : value;
+  }
+
+  if (typeof value === 'number' || typeof value === 'boolean') return value;
+  if (value instanceof Date) return value.toISOString();
+
+  if (Array.isArray(value)) {
+    const trimmed = value.slice(0, MAX_ARRAY).map((entry) => sanitizeForAudit(entry, depth + 1));
+    if (value.length > MAX_ARRAY) trimmed.push(`[${value.length - MAX_ARRAY} MORE ITEMS]`);
+    return trimmed;
+  }
+
+  if (typeof value === 'object') {
+    const output = {};
+    Object.entries(value).slice(0, MAX_OBJECT_KEYS).forEach(([key, entry]) => {
+      output[key] = SENSITIVE_KEY.test(key) ? '[REDACTED]' : sanitizeForAudit(entry, depth + 1);
+    });
+    if (Object.keys(value).length > MAX_OBJECT_KEYS) output.__truncatedKeys = true;
+    return output;
+  }
+
+  return String(value);
+}
+
+function clientIp(req) {
+  const forwarded = String(req.headers?.['x-forwarded-for'] || '').split(',')[0].trim();
+  return forwarded || req.ip || req.socket?.remoteAddress || null;
+}
+
+function actorSnapshot(req) {
+  const user = req.user || {};
+  const name = [user.firstName, user.lastName].filter(Boolean).join(' ').trim();
+  return {
+    userId: user.id && user.id !== 'TOS_INTEGRATION' ? user.id : null,
+    actorName: name || user.email || (req.isTosIntegration ? 'TOS Integration' : null),
+    actorEmail: user.email || null,
+    actorRole: user.role || null,
+    source: req.isTosIntegration ? 'TOS_INTEGRATION' : 'WEB',
+  };
+}
+
+function normalizeRoute(req) {
+  return String(req.originalUrl || req.url || '').split('?')[0] || '/';
+}
+
+function inferContext(req) {
+  const route = normalizeRoute(req);
+  const parts = route.replace(/^\/api\/v1\/?/, '').split('/').filter(Boolean);
+  const moduleName = String(parts[0] || 'system').replace(/[^a-zA-Z0-9]+/g, '_').toUpperCase();
+  const idPattern = /^(?:\d+|[0-9a-f]{8}-[0-9a-f-]{27,})$/i;
+  const semanticPattern = /^(approve|reject|run|generate|send|publish|close|cancel|restore|sync|release|pay|recalculate)$/i;
+
+  let entityId = null;
+  for (let index = parts.length - 1; index >= 1; index -= 1) {
+    if (idPattern.test(parts[index])) {
+      entityId = parts[index];
+      break;
+    }
+  }
+
+  let entityToken = parts[0] || 'system';
+  for (let index = parts.length - 1; index >= 1; index -= 1) {
+    const candidate = parts[index];
+    if (!idPattern.test(candidate) && !semanticPattern.test(candidate)) {
+      entityToken = candidate;
+      break;
+    }
+  }
+  const entity = String(entityToken).replace(/[^a-zA-Z0-9]+/g, '_').toUpperCase();
+
+  const method = String(req.method || 'UNKNOWN').toUpperCase();
+  let action = 'ACTION';
+  if (method === 'POST') action = 'CREATE';
+  if (method === 'PUT' || method === 'PATCH') action = 'UPDATE';
+  if (method === 'DELETE') action = 'DELETE';
+
+  const semanticAction = parts[parts.length - 1];
+  if (
+    ['POST', 'PUT', 'PATCH'].includes(method)
+    && semanticAction
+    && semanticPattern.test(semanticAction)
+  ) {
+    action = semanticAction.replace(/[^a-zA-Z0-9]+/g, '_').toUpperCase();
+  }
+
+  return { route, moduleName, entity, entityId, method, action };
+}
+
+async function recordAuditEvent(input) {
+  try {
+    return await prisma.auditLog.create({
+      data: {
+        userId: input.userId || null,
+        actorName: input.actorName || null,
+        actorEmail: input.actorEmail || null,
+        actorRole: input.actorRole || null,
+        action: input.action || 'ACTION',
+        module: input.module || 'SYSTEM',
+        entity: input.entity || null,
+        entityId: input.entityId ? String(input.entityId) : null,
+        summary: input.summary || null,
+        changes: sanitizeForAudit(input.changes),
+        beforeState: sanitizeForAudit(input.beforeState),
+        afterState: sanitizeForAudit(input.afterState),
+        metadata: sanitizeForAudit(input.metadata),
+        requestId: input.requestId || null,
+        method: input.method || null,
+        route: input.route || null,
+        outcome: input.outcome || 'SUCCESS',
+        statusCode: Number.isInteger(input.statusCode) ? input.statusCode : null,
+        source: input.source || 'WEB',
+        reversible: Boolean(input.reversible),
+        ipAddress: input.ipAddress || null,
+        userAgent: input.userAgent || null,
+      },
+    });
+  } catch (error) {
+    // Audit logging is fail-open in Phase 1: business operations must never fail
+    // merely because the ledger could not be written. Surface the failure to logs.
+    console.error('[CENTRAL_AUDIT_WRITE_FAILED]', error?.message || error);
+    return null;
+  }
+}
+
+module.exports = {
+  sanitizeForAudit,
+  clientIp,
+  actorSnapshot,
+  inferContext,
+  recordAuditEvent,
+};
diff --git a/backend/src/middleware/audit.middleware.js b/backend/src/middleware/audit.middleware.js
new file mode 100644
--- /dev/null
+++ b/backend/src/middleware/audit.middleware.js
@@ -0,0 +1,64 @@
+'use strict';
+
+const crypto = require('crypto');
+const {
+  sanitizeForAudit,
+  clientIp,
+  actorSnapshot,
+  inferContext,
+  recordAuditEvent,
+} = require('../services/audit.service');
+
+const MUTATING_METHODS = new Set(['POST', 'PUT', 'PATCH', 'DELETE']);
+
+function centralAuditMiddleware(req, res, next) {
+  if (!String(req.originalUrl || '').startsWith('/api/v1/')) return next();
+  if (!MUTATING_METHODS.has(String(req.method || '').toUpperCase())) return next();
+  if (String(req.originalUrl || '').startsWith('/api/v1/audit')) return next();
+
+  const requestId = String(req.headers['x-request-id'] || '').trim() || crypto.randomUUID();
+  const startedAt = Date.now();
+  req.auditRequestId = requestId;
+
+  if (!res.headersSent) res.setHeader('X-Request-Id', requestId);
+
+  res.once('finish', () => {
+    if (!req.user) return;
+
+    const actor = actorSnapshot(req);
+    const context = inferContext(req);
+    const statusCode = Number(res.statusCode || 0);
+    const outcome = statusCode >= 200 && statusCode < 400 ? 'SUCCESS' : 'FAILURE';
+
+    const payload = {
+      body: sanitizeForAudit(req.body),
+      query: sanitizeForAudit(req.query),
+    };
+
+    void recordAuditEvent({
+      ...actor,
+      action: context.action,
+      module: context.moduleName,
+      entity: context.entity,
+      entityId: context.entityId,
+      summary: `${context.action} ${context.entity} via ${context.method} ${context.route}`,
+      changes: payload,
+      metadata: {
+        durationMs: Date.now() - startedAt,
+        accessScope: req.accessScope || null,
+      },
+      requestId,
+      method: context.method,
+      route: context.route,
+      outcome,
+      statusCode,
+      reversible: false,
+      ipAddress: clientIp(req),
+      userAgent: req.get('user-agent') || null,
+    });
+  });
+
+  return next();
+}
+
+module.exports = centralAuditMiddleware;
diff --git a/backend/src/controllers/audit.controller.js b/backend/src/controllers/audit.controller.js
new file mode 100644
--- /dev/null
+++ b/backend/src/controllers/audit.controller.js
@@ -0,0 +1,156 @@
+'use strict';
+
+const prisma = require('../config/database');
+
+const MAX_PAGE_SIZE = 100;
+
+function clean(value) {
+  const text = String(value || '').trim();
+  return text || null;
+}
+
+function startOfToday() {
+  const now = new Date();
+  return new Date(now.getFullYear(), now.getMonth(), now.getDate());
+}
+
+function buildWhere(query) {
+  const where = {};
+  const search = clean(query.search);
+  const moduleName = clean(query.module);
+  const action = clean(query.action);
+  const outcome = clean(query.outcome);
+  const actor = clean(query.actor);
+  const from = clean(query.from);
+  const to = clean(query.to);
+
+  if (moduleName) where.module = moduleName;
+  if (action) where.action = action;
+  if (outcome) where.outcome = outcome;
+
+  if (actor) {
+    where.OR = [
+      { actorName: { contains: actor, mode: 'insensitive' } },
+      { actorEmail: { contains: actor, mode: 'insensitive' } },
+    ];
+  }
+
+  if (search) {
+    const searchOr = [
+      { actorName: { contains: search, mode: 'insensitive' } },
+      { actorEmail: { contains: search, mode: 'insensitive' } },
+      { action: { contains: search, mode: 'insensitive' } },
+      { module: { contains: search, mode: 'insensitive' } },
+      { entity: { contains: search, mode: 'insensitive' } },
+      { entityId: { contains: search, mode: 'insensitive' } },
+      { summary: { contains: search, mode: 'insensitive' } },
+      { route: { contains: search, mode: 'insensitive' } },
+      { requestId: { contains: search, mode: 'insensitive' } },
+    ];
+    if (where.OR) where.AND = [{ OR: where.OR }, { OR: searchOr }];
+    else where.OR = searchOr;
+  }
+
+  if (from || to) {
+    where.createdAt = {};
+    if (from) {
+      const date = new Date(`${from}T00:00:00`);
+      if (!Number.isNaN(date.getTime())) where.createdAt.gte = date;
+    }
+    if (to) {
+      const date = new Date(`${to}T23:59:59.999`);
+      if (!Number.isNaN(date.getTime())) where.createdAt.lte = date;
+    }
+    if (!Object.keys(where.createdAt).length) delete where.createdAt;
+  }
+
+  return where;
+}
+
+async function listEvents(req, res) {
+  try {
+    const page = Math.max(1, Number.parseInt(req.query.page, 10) || 1);
+    const pageSize = Math.min(MAX_PAGE_SIZE, Math.max(10, Number.parseInt(req.query.pageSize, 10) || 25));
+    const where = buildWhere(req.query);
+
+    const [total, events] = await Promise.all([
+      prisma.auditLog.count({ where }),
+      prisma.auditLog.findMany({
+        where,
+        orderBy: { createdAt: 'desc' },
+        skip: (page - 1) * pageSize,
+        take: pageSize,
+      }),
+    ]);
+
+    return res.json({
+      success: true,
+      data: {
+        events,
+        pagination: {
+          page,
+          pageSize,
+          total,
+          pages: Math.max(1, Math.ceil(total / pageSize)),
+        },
+      },
+    });
+  } catch (error) {
+    console.error('Central audit list error:', error);
+    return res.status(500).json({ success: false, message: 'Failed to load audit events' });
+  }
+}
+
+async function getEvent(req, res) {
+  try {
+    const event = await prisma.auditLog.findUnique({ where: { id: req.params.id } });
+    if (!event) return res.status(404).json({ success: false, message: 'Audit event not found' });
+    return res.json({ success: true, data: event });
+  } catch (error) {
+    console.error('Central audit detail error:', error);
+    return res.status(500).json({ success: false, message: 'Failed to load audit event' });
+  }
+}
+
+async function getSummary(req, res) {
+  try {
+    const today = startOfToday();
+    const last24Hours = new Date(Date.now() - (24 * 60 * 60 * 1000));
+
+    const [todayEvents, failed24h, actors24h, modules24h, latest] = await Promise.all([
+      prisma.auditLog.count({ where: { createdAt: { gte: today } } }),
+      prisma.auditLog.count({ where: { createdAt: { gte: last24Hours }, outcome: 'FAILURE' } }),
+      prisma.auditLog.groupBy({
+        by: ['actorEmail'],
+        where: { createdAt: { gte: last24Hours }, actorEmail: { not: null } },
+        _count: { _all: true },
+      }),
+      prisma.auditLog.groupBy({
+        by: ['module'],
+        where: { createdAt: { gte: last24Hours } },
+        _count: { _all: true },
+      }),
+      prisma.auditLog.findFirst({ orderBy: { createdAt: 'desc' }, select: { createdAt: true } }),
+    ]);
+
+    return res.json({
+      success: true,
+      data: {
+        todayEvents,
+        failed24h,
+        activeActors24h: actors24h.length,
+        activeModules24h: modules24h.length,
+        latestEventAt: latest?.createdAt || null,
+      },
+    });
+  } catch (error) {
+    console.error('Central audit summary error:', error);
+    return res.status(500).json({ success: false, message: 'Failed to load audit summary' });
+  }
+}
+
+module.exports = {
+  listEvents,
+  getEvent,
+  getSummary,
+};
