+++ b/frontend/src/pages/AuditCenter.jsx
@@ -0,0 +1,395 @@
+import React, { useCallback, useEffect, useMemo, useState } from 'react';
+import api from '../services/api';
+import '../styles/thrs-audit-center.css';
+
+const EMPTY_FILTERS = {
+  search: '',
+  module: '',
+  action: '',
+  outcome: '',
+  from: '',
+  to: '',
+};
+
+const ACTION_LABELS = {
+  CREATE: 'Created',
+  UPDATE: 'Updated',
+  DELETE: 'Deleted',
+  APPROVE: 'Approved',
+  REJECT: 'Rejected',
+  PAY: 'Paid',
+  RELEASE: 'Released',
+  RECALCULATE: 'Recalculated',
+  SYNC: 'Synced',
+  RUN: 'Run',
+  GENERATE: 'Generated',
+  SEND: 'Sent',
+  PUBLISH: 'Published',
+  CANCEL: 'Cancelled',
+};
+
+function prettyToken(value) {
+  return String(value || '—')
+    .replace(/_/g, ' ')
+    .toLowerCase()
+    .replace(/\b\w/g, (char) => char.toUpperCase());
+}
+
+function formatDate(value) {
+  if (!value) return '—';
+  const date = new Date(value);
+  if (Number.isNaN(date.getTime())) return '—';
+  return date.toLocaleString(undefined, {
+    year: 'numeric',
+    month: 'short',
+    day: '2-digit',
+    hour: '2-digit',
+    minute: '2-digit',
+    second: '2-digit',
+  });
+}
+
+function JsonBlock({ title, value }) {
+  if (value === null || value === undefined) return null;
+  return (
+    <section className="thrs-audit-json-card">
+      <div className="thrs-audit-json-title">{title}</div>
+      <pre>{JSON.stringify(value, null, 2)}</pre>
+    </section>
+  );
+}
+
+const AuditCenter = () => {
+  const [events, setEvents] = useState([]);
+  const [summary, setSummary] = useState({
+    todayEvents: 0,
+    failed24h: 0,
+    activeActors24h: 0,
+    activeModules24h: 0,
+    latestEventAt: null,
+  });
+  const [filters, setFilters] = useState(EMPTY_FILTERS);
+  const [appliedFilters, setAppliedFilters] = useState(EMPTY_FILTERS);
+  const [pagination, setPagination] = useState({ page: 1, pageSize: 25, total: 0, pages: 1 });
+  const [selected, setSelected] = useState(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState('');
+
+  const modules = useMemo(
+    () => Array.from(new Set(events.map((event) => event.module).filter(Boolean))).sort(),
+    [events]
+  );
+
+  const loadSummary = useCallback(async () => {
+    try {
+      const response = await api.get('/audit/summary');
+      setSummary(response?.data || {});
+    } catch (requestError) {
+      console.error('Audit summary failed:', requestError);
+    }
+  }, []);
+
+  const loadEvents = useCallback(async (page = 1, pageSize = pagination.pageSize) => {
+    setLoading(true);
+    setError('');
+    try {
+      const params = {
+        page,
+        pageSize,
+        ...Object.fromEntries(
+          Object.entries(appliedFilters).filter(([, value]) => String(value || '').trim())
+        ),
+      };
+      const response = await api.get('/audit/events', { params });
+      setEvents(response?.data?.events || []);
+      setPagination(response?.data?.pagination || { page, pageSize, total: 0, pages: 1 });
+    } catch (requestError) {
+      setError(requestError?.message || 'Failed to load central audit events.');
+    } finally {
+      setLoading(false);
+    }
+  }, [appliedFilters, pagination.pageSize]);
+
+  useEffect(() => {
+    loadSummary();
+  }, [loadSummary]);
+
+  useEffect(() => {
+    loadEvents(1, pagination.pageSize);
+    // pageSize is intentionally passed to the loader; applied filters own reloads.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [appliedFilters]);
+
+  const applyFilters = (event) => {
+    event.preventDefault();
+    setAppliedFilters({ ...filters });
+  };
+
+  const clearFilters = () => {
+    setFilters(EMPTY_FILTERS);
+    setAppliedFilters(EMPTY_FILTERS);
+  };
+
+  const changePageSize = (event) => {
+    const next = Number(event.target.value);
+    setPagination((current) => ({ ...current, pageSize: next }));
+    loadEvents(1, next);
+  };
+
+  const openDetails = async (event) => {
+    setSelected(event);
+    try {
+      const response = await api.get(`/audit/events/${event.id}`);
+      if (response?.data) setSelected(response.data);
+    } catch (requestError) {
+      console.error('Audit detail failed:', requestError);
+    }
+  };
+
+  return (
+    <div className="thrs-audit-center">
+      <header className="thrs-audit-hero">
+        <div>
+          <span className="thrs-audit-eyebrow">SYSTEM GOVERNANCE · PHASE 1</span>
+          <h1>Central Audit Center</h1>
+          <p>Immutable activity ledger for material changes across THRS.</p>
+        </div>
+        <div className="thrs-audit-phase-badge">
+          <span className="thrs-audit-live-dot" />
+          Audit backbone active
+        </div>
+      </header>
+
+      <section className="thrs-audit-kpis" aria-label="Audit summary">
+        <article>
+          <span>Events today</span>
+          <strong>{summary.todayEvents || 0}</strong>
+          <small>Recorded state-changing activity</small>
+        </article>
+        <article>
+          <span>Failed actions · 24h</span>
+          <strong>{summary.failed24h || 0}</strong>
+          <small>Authenticated attempts returning errors</small>
+        </article>
+        <article>
+          <span>Active actors · 24h</span>
+          <strong>{summary.activeActors24h || 0}</strong>
+          <small>Unique users in the ledger</small>
+        </article>
+        <article>
+          <span>Active modules · 24h</span>
+          <strong>{summary.activeModules24h || 0}</strong>
+          <small>System areas with recorded changes</small>
+        </article>
+      </section>
+
+      <section className="thrs-audit-governance-note">
+        <div>
+          <strong>Phase 1 records. It does not reverse.</strong>
+          <span>Soft Delete and Undo will be layered onto this ledger in later phases.</span>
+        </div>
+        <span className="thrs-audit-readonly-pill">READ-ONLY LEDGER</span>
+      </section>
+
+      <form className="thrs-audit-filters" onSubmit={applyFilters}>
+        <label className="thrs-audit-search">
+          <span>Search activity</span>
+          <input
+            value={filters.search}
+            onChange={(event) => setFilters((current) => ({ ...current, search: event.target.value }))}
+            placeholder="Actor, action, entity, request ID..."
+          />
+        </label>
+        <label>
+          <span>Module</span>
+          <input
+            list="thrs-audit-modules"
+            value={filters.module}
+            onChange={(event) => setFilters((current) => ({ ...current, module: event.target.value.toUpperCase() }))}
+            placeholder="All modules"
+          />
+          <datalist id="thrs-audit-modules">
+            {modules.map((moduleName) => <option key={moduleName} value={moduleName} />)}
+          </datalist>
+        </label>
+        <label>
+          <span>Action</span>
+          <select
+            value={filters.action}
+            onChange={(event) => setFilters((current) => ({ ...current, action: event.target.value }))}
+          >
+            <option value="">All actions</option>
+            <option value="CREATE">Create</option>
+            <option value="UPDATE">Update</option>
+            <option value="DELETE">Delete</option>
+            <option value="APPROVE">Approve</option>
+            <option value="REJECT">Reject</option>
+          </select>
+        </label>
+        <label>
+          <span>Outcome</span>
+          <select
+            value={filters.outcome}
+            onChange={(event) => setFilters((current) => ({ ...current, outcome: event.target.value }))}
+          >
+            <option value="">All outcomes</option>
+            <option value="SUCCESS">Success</option>
+            <option value="FAILURE">Failure</option>
+          </select>
+        </label>
+        <label>
+          <span>From</span>
+          <input type="date" value={filters.from} onChange={(event) => setFilters((current) => ({ ...current, from: event.target.value }))} />
+        </label>
+        <label>
+          <span>To</span>
+          <input type="date" value={filters.to} onChange={(event) => setFilters((current) => ({ ...current, to: event.target.value }))} />
+        </label>
+        <div className="thrs-audit-filter-actions">
+          <button type="button" onClick={clearFilters}>Clear</button>
+          <button type="submit" className="is-primary">Apply filters</button>
+        </div>
+      </form>
+
+      <section className="thrs-audit-ledger-card">
+        <div className="thrs-audit-ledger-head">
+          <div>
+            <span className="thrs-audit-eyebrow">CENTRAL LEDGER</span>
+            <h2>System Activity</h2>
+            <p>{pagination.total || 0} immutable audit events</p>
+          </div>
+          <label className="thrs-audit-page-size">
+            <span>Rows</span>
+            <select value={pagination.pageSize} onChange={changePageSize}>
+              <option value={25}>25</option>
+              <option value={50}>50</option>
+              <option value={100}>100</option>
+            </select>
+          </label>
+        </div>
+
+        {error && <div className="thrs-audit-error">{error}</div>}
+
+        <div className="thrs-audit-table-wrap">
+          <table className="thrs-audit-table">
+            <thead>
+              <tr>
+                <th>Time</th>
+                <th>Actor</th>
+                <th>Action</th>
+                <th>Module / Target</th>
+                <th>Outcome</th>
+                <th>Source</th>
+                <th aria-label="Details" />
+              </tr>
+            </thead>
+            <tbody>
+              {loading && (
+                <tr><td colSpan="7" className="thrs-audit-empty">Loading audit ledger…</td></tr>
+              )}
+              {!loading && events.length === 0 && (
+                <tr><td colSpan="7" className="thrs-audit-empty">No audit events match the current filters.</td></tr>
+              )}
+              {!loading && events.map((event) => (
+                <tr key={event.id}>
+                  <td>
+                    <strong className="thrs-audit-time">{formatDate(event.createdAt)}</strong>
+                    <small>{event.requestId ? event.requestId.slice(0, 8) : 'No request ID'}</small>
+                  </td>
+                  <td>
+                    <strong>{event.actorName || event.actorEmail || 'System actor'}</strong>
+                    <small>{event.actorRole ? prettyToken(event.actorRole) : '—'}</small>
+                  </td>
+                  <td>
+                    <span className={`thrs-audit-action is-${String(event.action || 'action').toLowerCase()}`}>
+                      {ACTION_LABELS[event.action] || prettyToken(event.action)}
+                    </span>
+                    <small>{event.method || '—'}</small>
+                  </td>
+                  <td>
+                    <strong>{prettyToken(event.module)}</strong>
+                    <small>{event.entity || '—'}{event.entityId ? ` · ${String(event.entityId).slice(0, 12)}` : ''}</small>
+                  </td>
+                  <td>
+                    <span className={`thrs-audit-outcome is-${String(event.outcome || '').toLowerCase()}`}>
+                      {prettyToken(event.outcome)}
+                    </span>
+                    <small>{event.statusCode || '—'}</small>
+                  </td>
+                  <td>
+                    <strong>{prettyToken(event.source)}</strong>
+                    <small>{event.reversible ? 'Reversible' : 'Recovery pending'}</small>
+                  </td>
+                  <td>
+                    <button className="thrs-audit-detail-button" type="button" onClick={() => openDetails(event)}>
+                      Inspect
+                    </button>
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+
+        <footer className="thrs-audit-pagination">
+          <span>Page {pagination.page} of {pagination.pages}</span>
+          <div>
+            <button
+              type="button"
+              disabled={pagination.page <= 1 || loading}
+              onClick={() => loadEvents(pagination.page - 1)}
+            >
+              Previous
+            </button>
+            <button
+              type="button"
+              disabled={pagination.page >= pagination.pages || loading}
+              onClick={() => loadEvents(pagination.page + 1)}
+            >
+              Next
+            </button>
+          </div>
+        </footer>
+      </section>
+
+      {selected && (
+        <div className="thrs-audit-drawer-backdrop" role="presentation" onMouseDown={() => setSelected(null)}>
+          <aside
+            className="thrs-audit-drawer"
+            role="dialog"
+            aria-modal="true"
+            aria-label="Audit event details"
+            onMouseDown={(event) => event.stopPropagation()}
+          >
+            <div className="thrs-audit-drawer-head">
+              <div>
+                <span className="thrs-audit-eyebrow">AUDIT EVENT</span>
+                <h2>{prettyToken(selected.action)} · {prettyToken(selected.module)}</h2>
+                <p>{selected.summary || selected.route || 'Recorded system activity'}</p>
+              </div>
+              <button type="button" onClick={() => setSelected(null)} aria-label="Close audit details">×</button>
+            </div>
+
+            <div className="thrs-audit-detail-grid">
+              <div><span>Actor</span><strong>{selected.actorName || selected.actorEmail || 'System actor'}</strong></div>
+              <div><span>Role</span><strong>{prettyToken(selected.actorRole)}</strong></div>
+              <div><span>Time</span><strong>{formatDate(selected.createdAt)}</strong></div>
+              <div><span>Outcome</span><strong>{prettyToken(selected.outcome)} · {selected.statusCode || '—'}</strong></div>
+              <div><span>Request ID</span><strong>{selected.requestId || '—'}</strong></div>
+              <div><span>Route</span><strong>{selected.method || '—'} {selected.route || '—'}</strong></div>
+              <div><span>IP address</span><strong>{selected.ipAddress || '—'}</strong></div>
+              <div><span>Recovery</span><strong>{selected.reversible ? 'Reversible' : 'Planned for Phase 3'}</strong></div>
+            </div>
+
+            <JsonBlock title="Recorded request" value={selected.changes} />
+            <JsonBlock title="Before state" value={selected.beforeState} />
+            <JsonBlock title="After state" value={selected.afterState} />
+            <JsonBlock title="Metadata" value={selected.metadata} />
+          </aside>
+        </div>
+      )}
+    </div>
+  );
+};
+
+export default AuditCenter;
