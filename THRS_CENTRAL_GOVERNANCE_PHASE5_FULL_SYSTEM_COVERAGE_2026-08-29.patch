diff --git a/backend/src/services/governance-coverage.service.js b/backend/src/services/governance-coverage.service.js
new file mode 100644
--- /dev/null
+++ b/backend/src/services/governance-coverage.service.js
@@ -0,0 +1,119 @@
+'use strict';
+
+const prisma = require('../config/database');
+
+const MODULE_POLICIES = Object.freeze([
+  {
+    module: 'EMPLOYEES',
+    audit: 'CENTRAL_AUDIT',
+    deletion: 'SOFT_DELETE',
+    recovery: 'RESTORE_AND_UNDO',
+    governance: 'CONFIRM_REQUIRES_APPROVAL',
+    note: 'Employee access is disabled while the employee record is hidden.',
+  },
+  {
+    module: 'RECRUITMENT',
+    audit: 'CENTRAL_AUDIT_AND_DOMAIN_EVENTS',
+    deletion: 'SOFT_DELETE',
+    recovery: 'STATE_UNDO_AND_RESTORE',
+    governance: 'CONFIRM_AND_UNDO_REQUIRE_APPROVAL',
+    note: 'Jobs and applications use governed deletion and conflict-safe recovery.',
+  },
+  {
+    module: 'ATTENDANCE',
+    audit: 'CENTRAL_AUDIT',
+    deletion: 'NOT_APPLICABLE',
+    recovery: 'CORRECTION_WORKFLOW',
+    governance: 'AUDIT_ONLY',
+    note: 'Time records remain historical; corrections are preferred over destructive rollback.',
+  },
+  {
+    module: 'LEAVE',
+    audit: 'CENTRAL_AUDIT',
+    deletion: 'NOT_APPLICABLE',
+    recovery: 'COMPENSATING_ACTION_REQUIRED',
+    governance: 'AUDIT_ONLY',
+    note: 'Leave decisions can have notification and TOS side effects, so automatic rollback is intentionally blocked.',
+  },
+  {
+    module: 'OVERTIME',
+    audit: 'CENTRAL_AUDIT',
+    deletion: 'NOT_APPLICABLE',
+    recovery: 'COMPENSATING_ACTION_REQUIRED',
+    governance: 'AUDIT_ONLY',
+    note: 'Overtime decisions can propagate externally and are not silently reversed.',
+  },
+  {
+    module: 'PAYROLL',
+    audit: 'CENTRAL_AUDIT',
+    deletion: 'DISABLED',
+    recovery: 'NO_AUTOMATIC_FINANCIAL_UNDO',
+    governance: 'EXISTING_SALARY_APPROVALS_PLUS_AUDIT',
+    note: 'Paid or externally synchronized financial state is never automatically rolled back.',
+  },
+  {
+    module: 'PERMISSIONS',
+    audit: 'CENTRAL_AUDIT',
+    deletion: 'NOT_APPLICABLE',
+    recovery: 'NO_AUTOMATIC_SECURITY_ROLLBACK',
+    governance: 'AUDIT_ONLY',
+    note: 'Security changes remain auditable but are not auto-reversed by the recovery engine.',
+  },
+]);
+
+function retentionDays() {
+  const value = Number(process.env.GOVERNANCE_RETENTION_DAYS || 365);
+  return Number.isFinite(value) && value >= 30 ? Math.floor(value) : 365;
+}
+
+async function getGovernanceCoverageReport() {
+  const days = retentionDays();
+  const cutoff = new Date(Date.now() - days * 24 * 60 * 60 * 1000);
+
+  const [
+    auditEvents,
+    activeDeletions,
+    confirmedDeletions,
+    restoredDeletions,
+    recoveries,
+    pendingActions,
+    approvedActions,
+    rejectedActions,
+    retentionReviewEligible,
+    auditGroups,
+  ] = await Promise.all([
+    prisma.auditLog.count(),
+    prisma.deletionRecord.count({ where: { isActive: true } }),
+    prisma.deletionRecord.count({ where: { status: 'CONFIRMED' } }),
+    prisma.deletionRecord.count({ where: { status: 'RESTORED' } }),
+    prisma.recoveryRecord.count(),
+    prisma.governanceAction.count({ where: { status: 'PENDING' } }),
+    prisma.governanceAction.count({ where: { status: 'APPROVED' } }),
+    prisma.governanceAction.count({ where: { status: 'REJECTED' } }),
+    prisma.deletionRecord.count({
+      where: { status: 'CONFIRMED', isActive: true, confirmedAt: { lte: cutoff } },
+    }),
+    prisma.auditLog.groupBy({ by: ['module'], _count: { id: true } }),
+  ]);
+
+  const auditByModule = Object.fromEntries(
+    auditGroups.map((row) => [String(row.module || 'SYSTEM').toUpperCase(), row._count.id])
+  );
+
+  return {
+    generatedAt: new Date(),
+    phase: 'PHASE_5_FULL_SYSTEM_COVERAGE',
+    totals: {
+      auditEvents,
+      activeDeletions,
+      confirmedDeletions,
+      restoredDeletions,
+      recoveries,
+      pendingActions,
+      approvedActions,
+      rejectedActions,
+    },
+    retention: {
+      retentionDays: days,
+      cutoff,
+      reviewEligible: retentionReviewEligible,
+      automaticPurge: false,
+      policy: 'REVIEW_ONLY_NO_AUTOMATIC_PURGE',
+    },
+    modules: MODULE_POLICIES.map((policy) => ({
+      ...policy,
+      auditEvents: auditByModule[policy.module] || auditByModule[policy.module.replace(/S$/, '')] || 0,
+    })),
+  };
+}
+
+module.exports = { MODULE_POLICIES, getGovernanceCoverageReport };
