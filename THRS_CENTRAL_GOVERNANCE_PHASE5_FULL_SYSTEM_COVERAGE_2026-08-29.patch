diff --git a/frontend/src/pages/GovernancePendingActions.jsx b/frontend/src/pages/GovernancePendingActions.jsx
new file mode 100644
--- /dev/null
+++ b/frontend/src/pages/GovernancePendingActions.jsx
@@ -0,0 +1,146 @@
+import React, { useCallback, useEffect, useState } from 'react';
+import api from '../services/api';
+import '../styles/thrs-governance-phase5.css';
+
+const pretty = (value) => String(value || '—').replace(/_/g, ' ').toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
+const when = (value) => {
+  if (!value) return '—';
+  const date = new Date(value);
+  return Number.isNaN(date.getTime()) ? '—' : date.toLocaleString();
+};
+
+const GovernancePendingActions = () => {
+  const [summary, setSummary] = useState({ pending: 0, approved: 0, rejected: 0, total: 0 });
+  const [requests, setRequests] = useState([]);
+  const [pagination, setPagination] = useState({ page: 1, pageSize: 25, total: 0, pages: 1 });
+  const [status, setStatus] = useState('PENDING');
+  const [review, setReview] = useState(null);
+  const [note, setNote] = useState('');
+  const [loading, setLoading] = useState(true);
+  const [submitting, setSubmitting] = useState(false);
+  const [message, setMessage] = useState('');
+  const [error, setError] = useState('');
+
+  const loadSummary = useCallback(async () => {
+    const response = await api.get('/governance/summary');
+    setSummary(response?.data?.data || {});
+  }, []);
+
+  const load = useCallback(async (page = 1) => {
+    setLoading(true);
+    setError('');
+    try {
+      const response = await api.get('/governance/requests', {
+        params: { page, pageSize: 25, status: status || undefined },
+      });
+      setRequests(response?.data?.data?.requests || []);
+      setPagination(response?.data?.data?.pagination || { page, pageSize: 25, total: 0, pages: 1 });
+    } catch (requestError) {
+      setError(requestError?.response?.data?.message || requestError?.message || 'Failed to load governance actions.');
+    } finally {
+      setLoading(false);
+    }
+  }, [status]);
+
+  useEffect(() => { loadSummary(); }, [loadSummary]);
+  useEffect(() => { load(1); }, [load]);
+
+  const decide = async () => {
+    if (!review || note.trim().length < 3 || submitting) return;
+    setSubmitting(true);
+    setError('');
+    try {
+      const verb = review.decision === 'APPROVE' ? 'approve' : 'reject';
+      const response = await api.post(`/governance/requests/${review.request.id}/${verb}`, { note: note.trim() });
+      setMessage(response?.data?.message || 'Governance request reviewed.');
+      setReview(null);
+      setNote('');
+      await Promise.all([loadSummary(), load(pagination.page)]);
+    } catch (requestError) {
+      setError(requestError?.response?.data?.message || requestError?.message || 'Governance review failed.');
+    } finally {
+      setSubmitting(false);
+    }
+  };
+
+  return (
+    <div className="thrs-gov-page">
+      <header className="thrs-gov-hero">
+        <div><span>SYSTEM GOVERNANCE · PHASE 5</span><h1>Pending Actions</h1><p>Approve or reject sensitive Undo and deletion-confirmation requests.</p></div>
+        <strong>PRIMARY SUPER ADMIN</strong>
+      </header>
+
+      <section className="thrs-gov-kpis">
+        <article><span>Pending</span><b>{summary.pending || 0}</b></article>
+        <article><span>Approved</span><b>{summary.approved || 0}</b></article>
+        <article><span>Rejected</span><b>{summary.rejected || 0}</b></article>
+        <article><span>Total</span><b>{summary.total || 0}</b></article>
+      </section>
+
+      <div className="thrs-gov-toolbar">
+        <select value={status} onChange={(event) => setStatus(event.target.value)}>
+          <option value="PENDING">Pending</option><option value="APPROVED">Approved</option>
+          <option value="REJECTED">Rejected</option><option value="">All</option>
+        </select>
+      </div>
+      {message && <div className="thrs-gov-message">{message}</div>}
+      {error && <div className="thrs-gov-error">{error}</div>}
+
+      <section className="thrs-gov-card">
+        <div className="thrs-gov-table-wrap"><table><thead><tr><th>Requested</th><th>Action</th><th>Target</th><th>Requester</th><th>Reason</th><th>Status</th><th /></tr></thead><tbody>
+          {loading && <tr><td colSpan="7">Loading…</td></tr>}
+          {!loading && !requests.length && <tr><td colSpan="7">No governance requests.</td></tr>}
+          {!loading && requests.map((item) => (
+            <tr key={item.id}>
+              <td>{when(item.requestedAt)}</td>
+              <td><strong>{pretty(item.actionType)}</strong><small>{pretty(item.module)}</small></td>
+              <td><strong>{pretty(item.entityType)}</strong><small>{String(item.entityId || item.targetAuditId || item.targetDeletionId || '—').slice(0, 18)}</small></td>
+              <td><strong>{item.requestedByName || item.requestedByEmail || 'System actor'}</strong><small>{pretty(item.requestedByRole)}</small></td>
+              <td>{item.reason}</td>
+              <td><span className={`is-${String(item.status).toLowerCase()}`}>{pretty(item.status)}</span></td>
+              <td>{item.status === 'PENDING' && <div className="thrs-gov-actions"><button onClick={() => { setReview({ request: item, decision: 'REJECT' }); setNote(''); }}>Reject</button><button className="is-approve" onClick={() => { setReview({ request: item, decision: 'APPROVE' }); setNote(''); }}>Approve</button></div>}</td>
+            </tr>
+          ))}
+        </tbody></table></div>
+        <footer><span>Page {pagination.page} of {pagination.pages}</span><div><button disabled={pagination.page <= 1} onClick={() => load(pagination.page - 1)}>Previous</button><button disabled={pagination.page >= pagination.pages} onClick={() => load(pagination.page + 1)}>Next</button></div></footer>
+      </section>
+
+      {review && <div className="thrs-gov-backdrop"><div className="thrs-gov-modal"><span>GOVERNANCE DECISION</span><h2>{review.decision === 'APPROVE' ? 'Approve and execute?' : 'Reject request?'}</h2><p>{pretty(review.request.actionType)} · {review.request.reason}</p><textarea value={note} onChange={(event) => setNote(event.target.value)} maxLength={1000} placeholder="Mandatory review note..." /><div><button disabled={submitting} onClick={() => setReview(null)}>Cancel</button><button className={review.decision === 'APPROVE' ? 'is-approve' : ''} disabled={submitting || note.trim().length < 3} onClick={decide}>{submitting ? 'Processing…' : review.decision === 'APPROVE' ? 'Approve & Execute' : 'Reject'}</button></div></div></div>}
+    </div>
+  );
+};
+
+export default GovernancePendingActions;
diff --git a/frontend/src/pages/SystemControlCenter.jsx b/frontend/src/pages/SystemControlCenter.jsx
new file mode 100644
