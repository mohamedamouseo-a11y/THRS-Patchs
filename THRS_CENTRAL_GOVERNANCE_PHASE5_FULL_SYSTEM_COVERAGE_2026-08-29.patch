+import React, { useEffect, useState } from 'react';
+import { Link } from 'react-router-dom';
+import api from '../services/api';
+import '../styles/thrs-governance-phase5.css';
+
+const pretty = (value) => String(value || '—').replace(/_/g, ' ').toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
+
+const SystemControlCenter = () => {
+  const [report, setReport] = useState(null);
+  const [error, setError] = useState('');
+
+  useEffect(() => {
+    api.get('/governance/coverage')
+      .then((response) => setReport(response?.data?.data || null))
+      .catch((requestError) => setError(requestError?.response?.data?.message || requestError?.message || 'Failed to load governance coverage.'));
+  }, []);
+
+  const totals = report?.totals || {};
+
+  return (
+    <div className="thrs-gov-page">
+      <header className="thrs-gov-hero">
+        <div><span>THRS SYSTEM GOVERNANCE · PHASE 5</span><h1>System Control Center</h1><p>One place for audit, recycle bin, pending approvals, recovery history, and module coverage.</p></div>
+        <strong>GOVERNANCE ACTIVE</strong>
+      </header>
+
+      <section className="thrs-control-links">
+        <Link to="/audit-center"><b>Audit Center</b><span>Immutable activity history</span></Link>
+        <Link to="/deletion-center"><b>Recycle Bin</b><span>Soft-deleted business records</span></Link>
+        <Link to="/pending-actions"><b>Pending Actions</b><span>Approve / reject sensitive actions</span></Link>
+        <Link to="/recovery-center"><b>Recovery Center</b><span>Recoverable audit events</span></Link>
+      </section>
+
+      {error && <div className="thrs-gov-error">{error}</div>}
+      <section className="thrs-gov-kpis">
+        <article><span>Audit events</span><b>{totals.auditEvents || 0}</b></article>
+        <article><span>Hidden records</span><b>{totals.activeDeletions || 0}</b></article>
+        <article><span>Recoveries</span><b>{totals.recoveries || 0}</b></article>
+        <article><span>Pending approvals</span><b>{totals.pendingActions || 0}</b></article>
+      </section>
+
+      <section className="thrs-gov-card">
+        <div className="thrs-gov-section-head"><div><span>FULL-SYSTEM COVERAGE</span><h2>Governance Policy Matrix</h2></div><small>Phase 5 closure</small></div>
+        <div className="thrs-gov-table-wrap"><table><thead><tr><th>Module</th><th>Audit</th><th>Delete policy</th><th>Recovery</th><th>Governance</th><th>Events</th></tr></thead><tbody>
+          {(report?.modules || []).map((item) => <tr key={item.module}><td><strong>{pretty(item.module)}</strong><small>{item.note}</small></td><td>{pretty(item.audit)}</td><td>{pretty(item.deletion)}</td><td>{pretty(item.recovery)}</td><td>{pretty(item.governance)}</td><td>{item.auditEvents || 0}</td></tr>)}
+          {!report && !error && <tr><td colSpan="6">Loading governance coverage…</td></tr>}
+        </tbody></table></div>
+      </section>
+
+      {report?.retention && <section className="thrs-retention-card"><div><span>Retention policy</span><b>{report.retention.retentionDays} days</b></div><div><span>Confirmed records ready for review</span><b>{report.retention.reviewEligible || 0}</b></div><div><span>Automatic purge</span><b>Disabled</b></div><p>Permanent purge is never automatic. Eligible records remain preserved until an explicit governance policy is approved.</p></section>}
+    </div>
+  );
+};
+
+export default SystemControlCenter;
