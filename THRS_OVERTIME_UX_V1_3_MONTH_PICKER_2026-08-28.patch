diff --git a/frontend/src/styles/thrs-overtime-v1-3-month-picker.css b/frontend/src/styles/thrs-overtime-v1-3-month-picker.css
new file mode 100644
--- /dev/null
+++ b/frontend/src/styles/thrs-overtime-v1-3-month-picker.css
@@ -0,0 +1,214 @@
+/* THRS Overtime V1.3 — Professional Month Picker
+   UI-only replacement for the browser-native month input. */
+
+.thrs-overtime-v1 .thrs-ot-month-filter {
+  position: relative;
+  display: grid;
+  gap: 5px;
+  min-width: 0;
+  align-self: end;
+  z-index: 30;
+}
+
+.thrs-overtime-v1 .thrs-ot-filter-label {
+  color: #708296;
+  font-size: 8px;
+  font-weight: 800;
+  text-transform: uppercase;
+  letter-spacing: .06em;
+}
+
+.thrs-overtime-v1 .thrs-ot-month-trigger {
+  width: 100%;
+  height: 38px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  padding: 0 12px;
+  border: 1px solid #d8e2ec;
+  border-radius: 9px;
+  background: #fff;
+  color: #30445d;
+  font: inherit;
+  font-size: 11px;
+  text-align: start;
+  cursor: pointer;
+  transition: border-color .16s ease, box-shadow .16s ease, background .16s ease;
+}
+
+.thrs-overtime-v1 .thrs-ot-month-trigger:hover {
+  border-color: #b8c7d8;
+  background: #fcfdff;
+}
+
+.thrs-overtime-v1 .thrs-ot-month-trigger:focus-visible,
+.thrs-overtime-v1 .thrs-ot-month-trigger.is-open {
+  outline: none;
+  border-color: #789bc0;
+  box-shadow: 0 0 0 3px rgba(37, 99, 235, .08);
+}
+
+.thrs-overtime-v1 .thrs-ot-month-trigger-icon {
+  flex: 0 0 auto;
+  color: #8091a5;
+  font-size: 16px;
+  line-height: 1;
+  transform: translateY(-1px);
+  transition: transform .16s ease;
+}
+
+.thrs-overtime-v1 .thrs-ot-month-trigger.is-open .thrs-ot-month-trigger-icon {
+  transform: rotate(180deg) translateY(1px);
+}
+
+.thrs-overtime-v1 .thrs-ot-month-popover {
+  position: absolute;
+  top: calc(100% + 8px);
+  inset-inline-end: 0;
+  width: 304px;
+  padding: 12px;
+  border: 1px solid #dbe4ee;
+  border-radius: 14px;
+  background: #fff;
+  box-shadow: 0 18px 50px rgba(11, 47, 85, .16), 0 3px 12px rgba(15, 23, 42, .07);
+  z-index: 90;
+  animation: thrsOtMonthIn .14s ease-out;
+}
+
+@keyframes thrsOtMonthIn {
+  from {
+    opacity: 0;
+    transform: translateY(-4px) scale(.985);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0) scale(1);
+  }
+}
+
+.thrs-overtime-v1 .thrs-ot-month-header {
+  display: grid;
+  grid-template-columns: 34px 1fr 34px;
+  align-items: center;
+  gap: 8px;
+  margin-bottom: 10px;
+}
+
+.thrs-overtime-v1 .thrs-ot-month-header strong {
+  color: #0b2f55;
+  font-size: 14px;
+  font-weight: 800;
+  text-align: center;
+}
+
+.thrs-overtime-v1 .thrs-ot-month-header button {
+  width: 34px;
+  height: 32px;
+  display: grid;
+  place-items: center;
+  border: 1px solid #e0e7ef;
+  border-radius: 9px;
+  background: #f8fafc;
+  color: #31506f;
+  font: inherit;
+  font-size: 20px;
+  line-height: 1;
+  cursor: pointer;
+}
+
+.thrs-overtime-v1 .thrs-ot-month-header button:hover {
+  border-color: #c8d5e3;
+  background: #f1f5f9;
+}
+
+.thrs-overtime-v1 .thrs-ot-month-grid {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: 6px;
+}
+
+.thrs-overtime-v1 .thrs-ot-month-grid button {
+  position: relative;
+  height: 38px;
+  border: 1px solid transparent;
+  border-radius: 9px;
+  background: transparent;
+  color: #52677e;
+  font: inherit;
+  font-size: 11px;
+  font-weight: 700;
+  cursor: pointer;
+  transition: background .14s ease, border-color .14s ease, color .14s ease, transform .14s ease;
+}
+
+.thrs-overtime-v1 .thrs-ot-month-grid button:hover {
+  border-color: #dce5ef;
+  background: #f7f9fc;
+  color: #0b2f55;
+  transform: translateY(-1px);
+}
+
+.thrs-overtime-v1 .thrs-ot-month-grid button.is-current:not(.is-selected)::after {
+  content: "";
+  position: absolute;
+  inset-inline-start: 50%;
+  bottom: 4px;
+  width: 4px;
+  height: 4px;
+  border-radius: 50%;
+  background: #c8a34a;
+  transform: translateX(-50%);
+}
+
+.thrs-overtime-v1 .thrs-ot-month-grid button.is-selected {
+  border-color: #0b2f55;
+  background: #0b2f55;
+  color: #fff;
+  box-shadow: 0 5px 12px rgba(11, 47, 85, .18);
+}
+
+.thrs-overtime-v1 .thrs-ot-month-footer {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  margin-top: 11px;
+  padding-top: 10px;
+  border-top: 1px solid #edf1f5;
+}
+
+.thrs-overtime-v1 .thrs-ot-month-footer button {
+  min-height: 31px;
+  padding: 0 10px;
+  border: 1px solid #dce5ef;
+  border-radius: 8px;
+  background: #fff;
+  color: #5d7086;
+  font: inherit;
+  font-size: 10px;
+  font-weight: 800;
+  cursor: pointer;
+}
+
+.thrs-overtime-v1 .thrs-ot-month-footer button:hover {
+  background: #f8fafc;
+}
+
+.thrs-overtime-v1 .thrs-ot-month-footer button.is-primary {
+  border-color: #0b2f55;
+  background: #0b2f55;
+  color: #fff;
+}
+
+@media (max-width: 760px) {
+  .thrs-overtime-v1 .thrs-ot-month-popover {
+    inset-inline-start: 0;
+    inset-inline-end: auto;
+    width: min(304px, calc(100vw - 40px));
+  }
+
+  .thrs-overtime-v1 .thrs-ot-month-grid {
+    grid-template-columns: repeat(3, 1fr);
+  }
+}
