new file mode 100644
--- /dev/null
+++ b/backend/src/services/recovery.action.service.js
@@ -0,0 +1,311 @@
+'use strict';
+
+const {
+  clientIp,
+  recordAuditEvent,
+  sanitizeForAudit,
+} = require('./audit.service');
+
+const SUPPORTED_ACTIONS = [
+  'CREATE_JOB',
+  'UPDATE_JOB',
+  'UPDATE_APPLICATION',
+  'STATUS_CHANGE_APPLICATION',
+];
+
+const ACTIONS = {
+  CREATE_JOB: {
+    kind: 'CREATE_COMPENSATION',
+    entity: 'JOB',
+    model: 'job',
+    guardFields: ['updatedAt'],
+    dateFields: ['updatedAt'],
+  },
+  UPDATE_JOB: {
+    kind: 'UPDATE',
+    entity: 'JOB',
+    model: 'job',
+    allowedFields: [
+      'title', 'description', 'requirements', 'location', 'jobType', 'workModel',
+      'salaryRange', 'status', 'positionCode', 'departmentId', 'closedAt',
+    ],
+    dateFields: ['closedAt'],
+  },
+  UPDATE_APPLICATION: {
+    kind: 'UPDATE',
+    entity: 'APPLICATION',
+    model: 'application',
+    allowedFields: [
+      'status', 'notes', 'targetPosition', 'recommendedDept',
+      'iqScore', 'enTestScore', 'depTestScore', 'aiTestScore',
+      'hrComment', 'ceoComment', 'gmdComment', 'mdComment', 'smdComment',
+      'experienceLevel', 'gender', 'rejectionReason', 'followUpDate',
+      'taskAssigned', 'taskCompleted', 'overallScore', 'startDate', 'departmentName',
+    ],
+    dateFields: ['followUpDate', 'startDate'],
+  },
+  STATUS_CHANGE_APPLICATION: {
+    kind: 'UPDATE',
+    entity: 'APPLICATION',
+    model: 'application',
+    allowedFields: ['status'],
+    dateFields: [],
+  },
+};
+
+function supports(action) {
+  return Boolean(ACTIONS[String(action || '').trim().toUpperCase()]);
+}
+
+function configFor(event) {
+  const config = ACTIONS[String(event?.action || '').trim().toUpperCase()];
+  if (!config) return null;
+  if (String(event?.entity || '').trim().toUpperCase() !== config.entity) return null;
+  return config;
+}
+
+function comparable(value, field, config) {
+  if (value === null || value === undefined) return value ?? null;
+  if ((config.dateFields || []).includes(field) || (config.guardFields || []).includes(field)) {
+    const date = value instanceof Date ? value : new Date(value);
+    return Number.isNaN(date.getTime()) ? String(value) : date.toISOString();
+  }
+  if (typeof value === 'object') return JSON.stringify(value);
+  return value;
+}
+
+function undoFields(event, config) {
+  const requested = Array.isArray(event?.metadata?.undoFields)
+    ? event.metadata.undoFields.map((field) => String(field))
+    : [];
+  const allowed = new Set(config.allowedFields || []);
+  return [...new Set(requested.filter((field) => allowed.has(field)))];
+}
+
+async function activeDeletion(db, entityType, entityId) {
+  return db.deletionRecord.findFirst({
+    where: {
+      entityType,
+      entityId: String(entityId),
+      isActive: true,
+    },
+    select: { id: true },
+  });
+}
+
+function recordMatchesState(record, state, fields, config) {
+  if (!record || !state) return false;
+  return fields.every(
+    (field) => comparable(record[field], field, config) === comparable(state[field], field, config)
+  );
+}
+
+function restoreData(event, config) {
+  const fields = undoFields(event, config);
+  const data = {};
+  for (const field of fields) {
+    let value = event?.beforeState?.[field];
+    if ((config.dateFields || []).includes(field) && value !== null && value !== undefined) {
+      const date = new Date(value);
+      if (Number.isNaN(date.getTime())) return { data: null, fields };
+      value = date;
+    }
+    data[field] = value ?? null;
+  }
+  return { data, fields };
+}
+
+async function getAvailability(db, event) {
+  const config = configFor(event);
+  if (!config) return { available: false, reason: 'ACTION_OR_ENTITY_NOT_SUPPORTED' };
+
+  const entityId = String(event?.entityId || '').trim();
+  if (!entityId) return { available: false, reason: 'ENTITY_ID_MISSING' };
+
+  const record = await db[config.model].findUnique({ where: { id: entityId } });
+  if (!record) return { available: false, reason: 'SOURCE_RECORD_MISSING' };
+
+  const deleted = await activeDeletion(db, config.entity, entityId);
+  if (deleted) return { available: false, reason: 'SOURCE_IS_SOFT_DELETED' };
+
+  if (config.kind === 'CREATE_COMPENSATION') {
+    if (config.entity === 'JOB') {
+      const applications = await db.application.count({ where: { jobId: entityId } });
+      if (applications > 0) return { available: false, reason: 'JOB_HAS_APPLICATIONS' };
+    }
+    const guards = config.guardFields || [];
+    if (!recordMatchesState(record, event.afterState, guards, config)) {
+      return { available: false, reason: 'SOURCE_CHANGED_AFTER_CREATE' };
+    }
+    return { available: true, reason: null, record };
+  }
+
+  const fields = undoFields(event, config);
+  if (!fields.length) return { available: false, reason: 'UNDO_FIELDS_MISSING' };
+  if (!recordMatchesState(record, event.afterState, fields, config)) {
+    return { available: false, reason: 'NEWER_CHANGE_CONFLICT' };
+  }
+
+  const restored = restoreData(event, config);
+  if (!restored.data) return { available: false, reason: 'INVALID_BEFORE_STATE' };
+  return { available: true, reason: null, record, fields, restoreData: restored.data };
+}
+
+async function writeRecoveryLedger({ tx, event, actor, req, reviewNote, beforeState, afterState, metadata }) {
+  const reversalEvent = await recordAuditEvent({
+    ...actor,
+    action: 'UNDO',
+    module: event.module,
+    entity: event.entity,
+    entityId: event.entityId,
+    summary: `Undo ${event.action} for ${event.entity || 'record'}`,
+    beforeState: sanitizeForAudit(beforeState),
+    afterState: sanitizeForAudit(afterState),
+    metadata: sanitizeForAudit({
+      reversalOfAuditId: event.id,
+      originalAction: event.action,
+      note: reviewNote,
+      ...metadata,
+    }),
+    requestId: req.auditRequestId || null,
+    method: req.method || 'POST',
+    route: req.originalUrl || null,
+    outcome: 'SUCCESS',
+    statusCode: 200,
+    source: actor.source || 'WEB',
+    reversible: false,
+    ipAddress: clientIp(req),
+    userAgent: req.get?.('user-agent') || null,
+  }, tx);
+
+  if (!reversalEvent) {
+    const error = new Error('Unable to write reversal audit event.');
+    error.statusCode = 500;
+    error.code = 'REVERSAL_AUDIT_WRITE_FAILED';
+    throw error;
+  }
+
+  const recovery = await tx.recoveryRecord.create({
+    data: {
+      originalAuditId: event.id,
+      reversalAuditId: reversalEvent.id,
+      module: event.module,
+      entityType: event.entity || null,
+      entityId: event.entityId || null,
+      originalAction: event.action,
+      status: 'COMPLETED',
+      note: reviewNote,
+      requestedById: actor.userId || null,
+      requestedByName: actor.actorName || null,
+      requestedByEmail: actor.actorEmail || null,
+      requestedByRole: actor.actorRole || null,
+      metadata: sanitizeForAudit({
+        requestId: req.auditRequestId || null,
+        recoveryKind: metadata?.recoveryKind || null,
+        changedFields: metadata?.changedFields || null,
+        deletionRecordId: metadata?.deletionRecordId || null,
+      }),
+    },
+  });
+
+  return { recovery, reversalEvent };
+}
+
+async function undo({ tx, event, actor, req, reviewNote, now }) {
+  const config = configFor(event);
+  if (!config) {
+    const error = new Error('This recovery action is not supported.');
+    error.statusCode = 409;
+    error.code = 'RECOVERY_NOT_SUPPORTED';
+    throw error;
+  }
+
+  const availability = await getAvailability(tx, event);
+  if (!availability.available) {
+    const error = new Error(`Undo blocked: ${availability.reason}`);
+    error.statusCode = 409;
+    error.code = availability.reason;
+    throw error;
+  }
+
+  if (config.kind === 'UPDATE') {
+    const beforeUndo = availability.record;
+    const updated = await tx[config.model].update({
+      where: { id: String(event.entityId) },
+      data: availability.restoreData,
+    });
+
+    const ledger = await writeRecoveryLedger({
+      tx,
+      event,
+      actor,
+      req,
+      reviewNote,
+      beforeState: beforeUndo,
+      afterState: updated,
+      metadata: {
+        recoveryKind: 'STATE_RESTORE',
+        changedFields: availability.fields,
+      },
+    });
+
+    return { ...ledger, restored: updated };
+  }
+
+  const source = availability.record;
+  const reason = `Undo ${event.action} from audit event ${event.id}`;
+  const deletion = await tx.deletionRecord.create({
+    data: {
+      module: event.module || 'RECRUITMENT',
+      entityType: config.entity,
+      entityId: String(event.entityId),
+      entityLabel: source.title || `${config.entity} ${event.entityId}`,
+      status: 'CONFIRMED',
+      isActive: true,
+      reason,
+      requestedById: actor.userId || null,
+      requestedByName: actor.actorName || null,
+      requestedByEmail: actor.actorEmail || null,
+      requestedByRole: actor.actorRole || null,
+      requestedAt: now,
+      reviewedById: actor.userId || null,
+      reviewedByName: actor.actorName || null,
+      reviewedByEmail: actor.actorEmail || null,
+      reviewedByRole: actor.actorRole || null,
+      reviewedAt: now,
+      confirmedAt: now,
+      snapshot: sanitizeForAudit(source),
+      metadata: sanitizeForAudit({
+        recoveryKind: 'CREATE_COMPENSATION',
+        reversalOfAuditId: event.id,
+      }),
+    },
+  });
+
+  const ledger = await writeRecoveryLedger({
+    tx,
+    event,
+    actor,
+    req,
+    reviewNote,
+    beforeState: source,
+    afterState: {
+      deletionRecordId: deletion.id,
+      status: deletion.status,
+      isActive: deletion.isActive,
+    },
+    metadata: {
+      recoveryKind: 'CREATE_COMPENSATION',
+      deletionRecordId: deletion.id,
+    },
+  });
+
+  return { ...ledger, restored: deletion };
+}
+
+module.exports = {
+  SUPPORTED_ACTIONS,
+  supports,
+  getAvailability,
+  undo,
+};
