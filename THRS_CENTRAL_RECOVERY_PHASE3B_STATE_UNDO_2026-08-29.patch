@@ -0,0 +1,88 @@
+'use strict';
+
+const {
+  actorSnapshot,
+  clientIp,
+  recordAuditEvent,
+  sanitizeForAudit,
+} = require('./audit.service');
+
+const JOB_SNAPSHOT_FIELDS = [
+  'id', 'title', 'description', 'requirements', 'location', 'jobType', 'workModel',
+  'salaryRange', 'status', 'positionCode', 'departmentId', 'postedAt', 'closedAt',
+  'createdAt', 'updatedAt',
+];
+
+const APPLICATION_SNAPSHOT_FIELDS = [
+  'id', 'status', 'notes', 'targetPosition', 'recommendedDept',
+  'iqScore', 'enTestScore', 'depTestScore', 'aiTestScore',
+  'hrComment', 'ceoComment', 'gmdComment', 'mdComment', 'smdComment',
+  'experienceLevel', 'gender', 'rejectionReason', 'followUpDate',
+  'taskAssigned', 'taskCompleted', 'overallScore', 'startDate', 'departmentName',
+  'createdAt', 'updatedAt',
+];
+
+function pick(record, fields) {
+  if (!record) return null;
+  const output = {};
+  for (const field of fields) {
+    if (record[field] !== undefined) output[field] = record[field];
+  }
+  return output;
+}
+
+function jobRecoverySnapshot(record) {
+  return pick(record, JOB_SNAPSHOT_FIELDS);
+}
+
+function applicationRecoverySnapshot(record) {
+  return pick(record, APPLICATION_SNAPSHOT_FIELDS);
+}
+
+async function recordRecruitmentRecoveryEvent(req, {
+  action,
+  entity,
+  entityId,
+  summary,
+  beforeState,
+  afterState,
+  undoFields,
+  metadata,
+  statusCode = 200,
+}) {
+  const actor = actorSnapshot(req);
+  const event = await recordAuditEvent({
+    ...actor,
+    action,
+    module: 'RECRUITMENT',
+    entity,
+    entityId: String(entityId),
+    summary,
+    beforeState: sanitizeForAudit(beforeState),
+    afterState: sanitizeForAudit(afterState),
+    metadata: sanitizeForAudit({
+      undoFields: [...new Set((undoFields || []).map((field) => String(field)))],
+      recoveryPhase: '3B',
+      ...metadata,
+    }),
+    requestId: req.auditRequestId || null,
+    method: req.method || null,
+    route: req.originalUrl || null,
+    outcome: 'SUCCESS',
+    statusCode,
+    source: actor.source || 'WEB',
+    reversible: true,
+    ipAddress: clientIp(req),
+    userAgent: req.get?.('user-agent') || null,
+  });
+
+  // Suppress the generic HTTP audit only when the richer reversible event was written.
+  if (event) req.skipCentralAudit = true;
+  return event;
+}
+
+module.exports = {
+  jobRecoverySnapshot,
+  applicationRecoverySnapshot,
+  recordRecruitmentRecoveryEvent,
+};
