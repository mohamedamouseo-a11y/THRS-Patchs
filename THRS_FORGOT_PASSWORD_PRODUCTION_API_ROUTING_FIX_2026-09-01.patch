-const API_URL = process.env.REACT_APP_API_URL || "http://localhost:5000/api/v1";
+const configuredApiUrl = String(process.env.REACT_APP_API_URL || "").trim();
+const browserHostname = typeof window !== "undefined" ? String(window.location.hostname || "").toLowerCase() : "";
+const isLocalBrowser = ["localhost", "127.0.0.1", "::1"].includes(browserHostname);
+const configuredApiTargetsLocalhost = /^https?:\/\/(?:localhost|127\.0\.0\.1|\[::1\])(?::\d+)?(?:\/|$)/i.test(configuredApiUrl);
+
+// Production is served by Nginx on the same host and /api/* is proxied to the
+// THRS backend. Never let a localhost URL baked into a production React build
+// send the user's browser to their own machine.
+const API_URL = (!isLocalBrowser && configuredApiTargetsLocalhost)
+  ? "/api/v1"
+  : (configuredApiUrl || (process.env.NODE_ENV === "production" ? "/api/v1" : "http://localhost:5000/api/v1"));
 
