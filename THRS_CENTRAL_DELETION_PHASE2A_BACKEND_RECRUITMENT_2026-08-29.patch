new file mode 100644
--- /dev/null
+++ b/backend/src/controllers/deletion.controller.js
@@ -0,0 +1,133 @@
+'use strict';
+
+const prisma = require('../config/database');
+const { reviewDeletion } = require('../services/deletion.service');
+
+const MAX_PAGE_SIZE = 100;
+
+function clean(value) {
+  const text = String(value || '').trim();
+  return text || null;
+}
+
+function parseDate(value, endOfDay = false) {
+  if (!value || !/^\d{4}-\d{2}-\d{2}$/.test(String(value))) return null;
+  const date = new Date(`${value}${endOfDay ? 'T23:59:59.999' : 'T00:00:00.000'}`);
+  return Number.isNaN(date.getTime()) ? null : date;
+}
+
+function buildWhere(query) {
+  const where = {};
+  const status = clean(query.status);
+  const moduleName = clean(query.module);
+  const entityType = clean(query.entityType);
+  const search = clean(query.search);
+
+  if (status) where.status = status;
+  if (moduleName) where.module = moduleName;
+  if (entityType) where.entityType = entityType;
+  if (query.active === 'true') where.isActive = true;
+  if (query.active === 'false') where.isActive = false;
+
+  if (search) {
+    where.OR = [
+      { entityLabel: { contains: search, mode: 'insensitive' } },
+      { entityType: { contains: search, mode: 'insensitive' } },
+      { entityId: { contains: search, mode: 'insensitive' } },
+      { module: { contains: search, mode: 'insensitive' } },
+      { requestedByName: { contains: search, mode: 'insensitive' } },
+      { requestedByEmail: { contains: search, mode: 'insensitive' } },
+      { reason: { contains: search, mode: 'insensitive' } },
+    ];
+  }
+
+  const from = parseDate(query.from);
+  const to = parseDate(query.to, true);
+  if (from || to) {
+    where.createdAt = {};
+    if (from) where.createdAt.gte = from;
+    if (to) where.createdAt.lte = to;
+  }
+  return where;
+}
+
+async function listRecords(req, res) {
+  try {
+    const page = Math.max(1, Number.parseInt(req.query.page, 10) || 1);
+    const pageSize = Math.min(MAX_PAGE_SIZE, Math.max(10, Number.parseInt(req.query.pageSize, 10) || 25));
+    const where = buildWhere(req.query);
+
+    const [total, records] = await Promise.all([
+      prisma.deletionRecord.count({ where }),
+      prisma.deletionRecord.findMany({
+        where,
+        orderBy: { createdAt: 'desc' },
+        skip: (page - 1) * pageSize,
+        take: pageSize,
+      }),
+    ]);
+
+    return res.json({
+      success: true,
+      data: {
+        records,
+        pagination: {
+          page,
+          pageSize,
+          total,
+          pages: Math.max(1, Math.ceil(total / pageSize)),
+        },
+      },
+    });
+  } catch (error) {
+    console.error('Deletion Center list error:', error);
+    return res.status(500).json({ success: false, message: 'Failed to load deletion records' });
+  }
+}
+
+async function getSummary(req, res) {
+  try {
+    const [pending, confirmed, restored, active, total] = await Promise.all([
+      prisma.deletionRecord.count({ where: { status: 'PENDING_REVIEW' } }),
+      prisma.deletionRecord.count({ where: { status: 'CONFIRMED' } }),
+      prisma.deletionRecord.count({ where: { status: 'RESTORED' } }),
+      prisma.deletionRecord.count({ where: { isActive: true } }),
+      prisma.deletionRecord.count(),
+    ]);
+    return res.json({ success: true, data: { pending, confirmed, restored, active, total } });
+  } catch (error) {
+    console.error('Deletion Center summary error:', error);
+    return res.status(500).json({ success: false, message: 'Failed to load deletion summary' });
+  }
+}
+
+async function getRecord(req, res) {
+  try {
+    const record = await prisma.deletionRecord.findUnique({ where: { id: req.params.id } });
+    if (!record) return res.status(404).json({ success: false, message: 'Deletion record not found' });
+    return res.json({ success: true, data: record });
+  } catch (error) {
+    console.error('Deletion Center detail error:', error);
+    return res.status(500).json({ success: false, message: 'Failed to load deletion record' });
+  }
+}
+
+async function confirmRecord(req, res) {
+  try {
+    const record = await reviewDeletion(req, req.params.id, 'CONFIRM', req.body?.note);
+    return res.json({ success: true, message: 'Soft deletion confirmed by Super Admin.', data: record });
+  } catch (error) {
+    return res.status(error.statusCode || 500).json({ success: false, message: error.message || 'Failed to confirm deletion' });
+  }
+}
+
+async function restoreRecord(req, res) {
+  try {
+    const record = await reviewDeletion(req, req.params.id, 'RESTORE', req.body?.note);
+    return res.json({ success: true, message: 'Record restored successfully.', data: record });
+  } catch (error) {
+    return res.status(error.statusCode || 500).json({ success: false, message: error.message || 'Failed to restore record' });
+  }
+}
+
+module.exports = { listRecords, getSummary, getRecord, confirmRecord, restoreRecord };
diff --git a/backend/src/routes/deletion.routes.js b/backend/src/routes/deletion.routes.js
