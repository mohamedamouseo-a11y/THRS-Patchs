+++ b/backend/prisma/migrations/20260829000200_central_deletion_governance/migration.sql
@@ -0,0 +1,42 @@
+-- THRS Central Soft Delete & Deletion Governance — Phase 2
+-- Adds the central recycle-bin ledger. Business records remain physically intact.
+
+CREATE TABLE "deletion_records" (
+  "id" TEXT NOT NULL,
+  "module" TEXT NOT NULL DEFAULT 'SYSTEM',
+  "entityType" TEXT NOT NULL,
+  "entityId" TEXT NOT NULL,
+  "entityLabel" TEXT,
+  "status" TEXT NOT NULL DEFAULT 'PENDING_REVIEW',
+  "isActive" BOOLEAN NOT NULL DEFAULT true,
+  "reason" TEXT NOT NULL,
+  "requestedById" TEXT,
+  "requestedByName" TEXT,
+  "requestedByEmail" TEXT,
+  "requestedByRole" TEXT,
+  "requestedAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  "reviewedById" TEXT,
+  "reviewedByName" TEXT,
+  "reviewedByEmail" TEXT,
+  "reviewedByRole" TEXT,
+  "reviewedAt" TIMESTAMP(3),
+  "reviewNote" TEXT,
+  "confirmedAt" TIMESTAMP(3),
+  "restoredAt" TIMESTAMP(3),
+  "snapshot" JSONB,
+  "metadata" JSONB,
+  "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  "updatedAt" TIMESTAMP(3) NOT NULL,
+  CONSTRAINT "deletion_records_pkey" PRIMARY KEY ("id")
+);
+
+CREATE INDEX "deletion_records_status_createdAt_idx"
+  ON "deletion_records"("status", "createdAt");
+CREATE INDEX "deletion_records_module_createdAt_idx"
+  ON "deletion_records"("module", "createdAt");
+CREATE INDEX "deletion_records_entityType_entityId_idx"
+  ON "deletion_records"("entityType", "entityId");
+CREATE INDEX "deletion_records_isActive_entityType_idx"
+  ON "deletion_records"("isActive", "entityType");
+CREATE INDEX "deletion_records_requestedById_createdAt_idx"
+  ON "deletion_records"("requestedById", "createdAt");
diff --git a/backend/src/services/deletion.service.js b/backend/src/services/deletion.service.js
new file mode 100644
--- /dev/null
+++ b/backend/src/services/deletion.service.js
@@ -0,0 +1,243 @@
+'use strict';
+
+const prisma = require('../config/database');
+const {
+  actorSnapshot,
+  sanitizeForAudit,
+  recordAuditEvent,
+  clientIp,
+} = require('./audit.service');
+
+const STATUS_PENDING = 'PENDING_REVIEW';
+const STATUS_CONFIRMED = 'CONFIRMED';
+const STATUS_RESTORED = 'RESTORED';
+
+function makeHttpError(statusCode, message) {
+  const error = new Error(message);
+  error.statusCode = statusCode;
+  return error;
+}
+
+function cleanReason(value, fallback) {
+  const text = String(value || '').trim();
+  return (text || fallback || 'Deletion requested from THRS').slice(0, 1000);
+}
+
+const ENTITY_ADAPTERS = {
+  JOB: {
+    module: 'RECRUITMENT',
+    async load(id) {
+      return prisma.job.findUnique({
+        where: { id: String(id) },
+        select: {
+          id: true, title: true, status: true, departmentId: true,
+          positionCode: true, postedAt: true, createdAt: true, updatedAt: true,
+        },
+      });
+    },
+    label(record) {
+      return record?.title || `Job ${record?.id || ''}`.trim();
+    },
+  },
+  APPLICATION: {
+    module: 'RECRUITMENT',
+    async load(id) {
+      return prisma.application.findUnique({
+        where: { id: String(id) },
+        select: {
+          id: true, firstName: true, lastName: true, email: true, phone: true,
+          targetPosition: true, departmentName: true, status: true, source: true,
+          appliedAt: true, createdAt: true, updatedAt: true,
+        },
+      });
+    },
+    label(record) {
+      const name = [record?.firstName, record?.lastName].filter(Boolean).join(' ').trim();
+      return name || record?.email || record?.phone || `Application ${record?.id || ''}`.trim();
+    },
+  },
+};
+
+function normalizeEntityType(value) {
+  return String(value || '').trim().toUpperCase();
+}
+
+function getAdapter(entityType) {
+  const normalized = normalizeEntityType(entityType);
+  const adapter = ENTITY_ADAPTERS[normalized];
+  if (!adapter) throw makeHttpError(400, `Soft delete is not enabled for ${normalized || 'this entity'} yet.`);
+  return { normalized, adapter };
+}
+
+async function getActiveDeletionIds(entityType) {
+  const normalized = normalizeEntityType(entityType);
+  if (!normalized) return [];
+  const rows = await prisma.deletionRecord.findMany({
+    where: { entityType: normalized, isActive: true },
+    select: { entityId: true },
+  });
+  return rows.map((row) => row.entityId);
+}
+
+async function isEntitySoftDeleted(entityType, entityId) {
+  const normalized = normalizeEntityType(entityType);
+  if (!normalized || entityId === null || entityId === undefined) return false;
+  const row = await prisma.deletionRecord.findFirst({
+    where: { entityType: normalized, entityId: String(entityId), isActive: true },
+    select: { id: true },
+  });
+  return Boolean(row);
+}
+
+async function assertEntityVisible(entityType, entityId) {
+  if (await isEntitySoftDeleted(entityType, entityId)) {
+    throw makeHttpError(404, 'Record not found');
+  }
+}
+
+async function requestSoftDelete(req, entityType, entityId, reason) {
+  const { normalized, adapter } = getAdapter(entityType);
+  const normalizedId = String(entityId || '').trim();
+  if (!normalizedId) throw makeHttpError(400, 'Entity ID is required.');
+
+  const existing = await prisma.deletionRecord.findFirst({
+    where: { entityType: normalized, entityId: normalizedId, isActive: true },
+    orderBy: { createdAt: 'desc' },
+  });
+  if (existing) return { record: existing, alreadyDeleted: true };
+
+  const sourceRecord = await adapter.load(normalizedId);
+  if (!sourceRecord) throw makeHttpError(404, 'Record not found');
+
+  const actor = actorSnapshot(req);
+  const snapshot = sanitizeForAudit(sourceRecord);
+  // The domain-level SOFT_DELETE event below is richer than the generic HTTP audit event.
+  req.skipCentralAudit = true;
+  const resolvedReason = cleanReason(reason, `Requested from ${adapter.module}`);
+
+  const record = await prisma.deletionRecord.create({
+    data: {
+      module: adapter.module,
+      entityType: normalized,
+      entityId: normalizedId,
+      entityLabel: adapter.label(sourceRecord),
+      status: STATUS_PENDING,
+      isActive: true,
+      reason: resolvedReason,
+      requestedById: actor.userId || null,
+      requestedByName: actor.actorName || null,
+      requestedByEmail: actor.actorEmail || null,
+      requestedByRole: actor.actorRole || null,
+      snapshot,
+      metadata: {
+        source: actor.source || 'WEB',
+        route: req.originalUrl || null,
+        requestId: req.auditRequestId || null,
+      },
+    },
+  });
+
+  await recordAuditEvent({
+    ...actor,
+    action: 'SOFT_DELETE',
+    module: adapter.module,
+    entity: normalized,
+    entityId: normalizedId,
+    summary: `Soft deleted ${normalized} pending Super Admin review`,
+    beforeState: snapshot,
+    afterState: { deletionRecordId: record.id, status: record.status, isActive: true },
+    metadata: { deletionRecordId: record.id, reason: resolvedReason },
+    requestId: req.auditRequestId || null,
+    method: req.method || 'DELETE',
+    route: req.originalUrl || null,
+    outcome: 'SUCCESS',
+    statusCode: 202,
+    source: actor.source || 'WEB',
+    reversible: true,
+    ipAddress: clientIp(req),
+    userAgent: req.get?.('user-agent') || null,
+  });
+
+  return { record, alreadyDeleted: false };
+}
+
+async function reviewDeletion(req, deletionId, decision, note) {
+  const record = await prisma.deletionRecord.findUnique({ where: { id: String(deletionId) } });
+  if (!record) throw makeHttpError(404, 'Deletion record not found');
+
+  const normalizedDecision = String(decision || '').trim().toUpperCase();
+  if (!['CONFIRM', 'RESTORE'].includes(normalizedDecision)) {
+    throw makeHttpError(400, 'Invalid deletion review decision');
+  }
+  if (!record.isActive && normalizedDecision === 'RESTORE') return record;
+  if (record.status === STATUS_CONFIRMED && normalizedDecision === 'CONFIRM') return record;
+
+  const actor = actorSnapshot(req);
+  const now = new Date();
+  const isRestore = normalizedDecision === 'RESTORE';
+
+  const updated = await prisma.deletionRecord.update({
+    where: { id: record.id },
+    data: {
+      status: isRestore ? STATUS_RESTORED : STATUS_CONFIRMED,
+      isActive: !isRestore,
+      reviewedById: actor.userId || null,
+      reviewedByName: actor.actorName || null,
+      reviewedByEmail: actor.actorEmail || null,
+      reviewedByRole: actor.actorRole || null,
+      reviewedAt: now,
+      reviewNote: String(note || '').trim().slice(0, 1000) || null,
+      restoredAt: isRestore ? now : record.restoredAt,
+      confirmedAt: isRestore ? record.confirmedAt : now,
+    },
+  });
+
+  await recordAuditEvent({
+    ...actor,
+    action: isRestore ? 'RESTORE' : 'CONFIRM_DELETE',
+    module: record.module,
+    entity: record.entityType,
+    entityId: record.entityId,
+    summary: isRestore
+      ? `Restored ${record.entityType} from Recycle Bin`
+      : `Confirmed soft deletion of ${record.entityType}`,
+    beforeState: {
+      deletionRecordId: record.id,
+      status: record.status,
+      isActive: record.isActive,
+      snapshot: record.snapshot,
+    },
+    afterState: {
+      deletionRecordId: updated.id,
+      status: updated.status,
+      isActive: updated.isActive,
+    },
+    metadata: {
+      reviewNote: updated.reviewNote,
+      originalRequester: record.requestedByEmail || record.requestedByName || null,
+    },
+    requestId: req.auditRequestId || null,
+    method: req.method || 'POST',
+    route: req.originalUrl || null,
+    outcome: 'SUCCESS',
+    statusCode: 200,
+    source: actor.source || 'WEB',
+    reversible: !isRestore,
+    ipAddress: clientIp(req),
+    userAgent: req.get?.('user-agent') || null,
+  });
+
+  return updated;
+}
+
+module.exports = {
+  STATUS_PENDING,
+  STATUS_CONFIRMED,
+  STATUS_RESTORED,
+  ENTITY_ADAPTERS,
+  getActiveDeletionIds,
+  isEntitySoftDeleted,
+  assertEntityVisible,
+  requestSoftDelete,
+  reviewDeletion,
+};
