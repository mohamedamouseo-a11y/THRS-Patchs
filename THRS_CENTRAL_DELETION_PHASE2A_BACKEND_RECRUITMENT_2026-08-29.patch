+++ b/backend/src/routes/deletion.routes.js
@@ -0,0 +1,28 @@
+'use strict';
+
+const express = require('express');
+const router = express.Router();
+const authMiddleware = require('../middleware/auth.middleware');
+const deletionController = require('../controllers/deletion.controller');
+const { isReservedSuperAdmin } = require('../utils/superAdmin');
+
+function primarySuperAdminOnly(req, res, next) {
+  if (req.user?.role !== 'SUPER_ADMIN' || !isReservedSuperAdmin(req.user)) {
+    return res.status(403).json({
+      success: false,
+      message: 'Deletion Center is limited to the primary Super Admin.',
+    });
+  }
+  return next();
+}
+
+router.use(authMiddleware);
+router.use(primarySuperAdminOnly);
+
+router.get('/summary', deletionController.getSummary);
+router.get('/records', deletionController.listRecords);
+router.get('/records/:id', deletionController.getRecord);
+router.post('/records/:id/confirm', deletionController.confirmRecord);
+router.post('/records/:id/restore', deletionController.restoreRecord);
+
+module.exports = router;
